---
import BaseLayout from '../layouts/BaseLayout.astro';

const partnersList = [
  {
    name: 'Samsung',
    logo: '/home/partners/samsung.webp',
    category: 'Technology & Electronics',
    description: 'Global innovation benchmark across semiconductors, smart infrastructure, and cognitive consumer electronics.'
  },
  {
    name: 'Hyundai Engineering & Construction',
    logo: '/home/partners/hyundai-ec.webp',
    category: 'Infrastructure & EPC',
    description: 'Leading international EPC contractor executing major energy, transport, and smart city mega-projects.'
  },
  {
    name: 'Hanwha',
    logo: '/home/partners/hanwha.webp',
    category: 'Energy & Aerospace',
    description: 'Diversified leader across solar energy, sustainable chemicals, defense technology, and aerospace engineering.'
  },
  {
    name: 'Nice One Saudi',
    logo: '/home/partners/nice-one.webp',
    category: 'E-Commerce & Retail',
    description: 'The Kingdom’s premier digital beauty and cosmetics marketplace, connecting millions of consumers with curated brands.'
  },
  {
    name: 'Saudi-South Korean Business Council',
    logo: '/home/partners/saudi-korea-council.webp',
    category: 'Bilateral Trade Council',
    description: 'Apex institutional body fostering reciprocal investment, government trade missions, and bilateral joint ventures.'
  },
  {
    name: 'Care Outlet',
    logo: '/home/partners/care-outlet.webp',
    category: 'Beauty & Personal Care',
    description: 'High-growth retail pharmacy and personal care distribution chain across Saudi Arabia and the GCC.'
  },
  {
    name: 'Almajdouie',
    logo: '/home/partners/almajdouie.webp',
    category: 'Logistics & Automotive',
    description: 'Prominent Saudi conglomerate operating major logistics fleets, heavy transport, and premier automotive dealerships.'
  },
  {
    name: 'Al Jabr',
    logo: '/home/partners/aljabr.webp',
    category: 'Automotive & Industrial',
    description: 'Historic Saudi automotive group, commercial fleet distributor, and diversified industrial trading house.'
  },
  {
    name: 'Wallan',
    logo: '/home/partners/wallan.webp',
    category: 'Mobility & Aviation',
    description: 'Leading transport, automotive dealership, and aviation enterprise in the Kingdom of Saudi Arabia.'
  },
  {
    name: 'Arabio',
    logo: '/home/partners/arabio.webp',
    category: 'Biopharmaceuticals',
    description: 'First biopharmaceutical manufacturing facility in the GCC specializing in human vaccines and biological products.'
  },
  {
    name: 'Al Falah',
    logo: '/home/partners/al-falah.webp',
    category: 'Industrial Trading & Supply',
    description: 'Established commercial and industrial trading group supporting building materials and infrastructure supply chains.'
  }
];
---

<BaseLayout
  title="Strategic Partners & Ecosystem | KoreaIN"
  description="Discover KoreaIN's trusted ecosystem of corporate, industrial, and institutional partners across South Korea, Saudi Arabia, and the GCC."
>
  <main id="main-content" class="page-partners">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Strategic Partners</li>
          </ol>
        </nav>

        <div class="page-hero__content">
          <h1 class="page-title">Our Strategic Partner Ecosystem</h1>
          <p class="page-lead">
            KoreaIN collaborates with global conglomerates, regional market leaders, bilateral trade councils, and innovative scale-ups to create enduring commercial value between Korea and the Middle East.
          </p>
        </div>
      </div>
    </header>

    <!-- Partners Grid Section -->
    <section class="section partners-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Corporate &amp; Institutional Alliances</h2>
          <p class="section-copy">
            A verified network spanning industrial manufacturing, clean mobility, retail distribution, pharmaceuticals, and bilateral trade facilitation.
          </p>
        </header>

        <div class="partners-grid">
          {
            partnersList.map((partner) => (
              <article class="partner-card">
                <div class="partner-card__visual">
                  <img
                    src={partner.logo}
                    alt={`${partner.name} logo`}
                    loading="lazy"
                    decoding="async"
                    class="partner-card__logo"
                  />
                </div>
                <div class="partner-card__body">
                  <span class="partner-card__category">{partner.category}</span>
                  <h3 class="partner-card__name">{partner.name}</h3>
                  <p class="partner-card__desc">{partner.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Black Rectangle Visual Showcase -->
    <section class="section visual-section">
      <div class="container">
        <div class="black-placeholder" aria-label="Bilateral signing ceremony placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">Bilateral Trade Council Summits &amp; Partner Signing Ceremonies — Photography Pending</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Become a Strategic Partner</h2>
          <p class="cta-card__copy">
            Join KoreaIN’s bilateral ecosystem to unlock direct market access, investment syndicates, and commercial joint ventures.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Explore Partnership Opportunities</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/about" class="button button--secondary">
              <span>About KoreaIN Leadership</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }

  /* Partners Grid */
  .section-header {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .partner-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .partner-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-secondary) 35%, var(--color-border));
  }

  .partner-card__visual {
    height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .partner-card__logo {
    max-height: 3rem;
    max-width: 85%;
    width: auto;
    object-fit: contain;
  }

  .partner-card__category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .partner-card__name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .partner-card__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0;
  }

  /* Visual Showcase */
  .visual-section {
    padding-top: 0;
  }

  .black-placeholder {
    width: 100%;
    aspect-ratio: 21 / 8;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }

  .black-placeholder__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  .black-placeholder__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .black-placeholder__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .black-placeholder__note {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 26rem;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }


  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .partners-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .partners-grid {
      grid-template-columns: 1fr;
    }
  }
</style>