---
import BaseLayout from '../layouts/BaseLayout.astro';

const filterCategories = [
  { id: 'all', label: 'All' },
  { id: 'tech', label: 'Conglomerates & Tech' },
  { id: 'mobility', label: 'Infrastructure & Mobility' },
  { id: 'retail', label: 'Retail & Healthcare' },
  { id: 'councils', label: 'Bilateral Councils' }
];

const partners = [
  {
    name: 'Samsung',
    logo: '/home/partners/samsung.webp',
    category: 'Technology & Electronics',
    filterGroup: 'tech',
    width: 400,
    height: 62
  },
  {
    name: 'Hyundai Engineering & Construction',
    logo: '/home/partners/hyundai-ec.webp',
    category: 'Infrastructure & EPC',
    filterGroup: 'mobility',
    width: 400,
    height: 70
  },
  {
    name: 'Hanwha',
    logo: '/home/partners/hanwha.webp',
    category: 'Energy & Aerospace',
    filterGroup: 'tech',
    width: 400,
    height: 111
  },
  {
    name: 'Nice One Saudi',
    logo: '/home/partners/nice-one.webp',
    category: 'E-Commerce & Retail',
    filterGroup: 'retail',
    width: 400,
    height: 140
  },
  {
    name: 'Saudi-South Korean Business Council',
    logo: '/home/partners/saudi-korea-council.webp',
    category: 'Bilateral Trade Council',
    filterGroup: 'councils',
    width: 263,
    height: 160
  },
  {
    name: 'Care Outlet',
    logo: '/home/partners/care-outlet.webp',
    category: 'Beauty & Personal Care',
    filterGroup: 'retail',
    width: 157,
    height: 160
  },
  {
    name: 'Almajdouie',
    logo: '/home/partners/almajdouie.png',
    category: 'Logistics & Automotive',
    filterGroup: 'mobility',
    width: 400,
    height: 133
  },
  {
    name: 'Al Jabr',
    logo: '/home/partners/aljabr.webp',
    category: 'Automotive & Industrial',
    filterGroup: 'mobility',
    width: 252,
    height: 160
  },
  {
    name: 'Wallan',
    logo: '/home/partners/wallan.webp',
    category: 'Mobility & Aviation',
    filterGroup: 'mobility',
    width: 324,
    height: 160
  },
  {
    name: 'Arabio',
    logo: '/home/partners/arabio.webp',
    category: 'Biopharmaceuticals',
    filterGroup: 'retail',
    width: 400,
    height: 118
  },
  {
    name: 'Al Falah',
    logo: '/home/partners/falah_auto.png',
    category: 'Industrial Trading & Supply',
    filterGroup: 'tech',
    width: 400,
    height: 82
  }
];
---

<BaseLayout
  title="Strategic Partners & Ecosystem | KoreaIN"
  description="Discover KoreaIN's trusted ecosystem of corporate, industrial, and institutional partners across South Korea and Saudi Arabia, designed with Amorepacific-inspired minimalism."
>
  <main id="main-content" class="partners-portal">
    <!-- 1. Hero Cover (Grand Visuel with Harmonized Height) -->
    <header id="cover" class="cover" aria-labelledby="cover-title">
      <div class="cover-spacer">
        <div
          class="cover-bg"
          id="coverBg"
          style="background-image: url('/home/partners/partners_hero-1600.webp');"
        ></div>
        <div class="cover-overlay"></div>
      </div>

      <div class="container cover-content" id="coverContent">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Strategic Partners</li>
          </ol>
        </nav>

        <h1 id="cover-title" class="cover-h">Strategic Partners</h1>
        <p class="cover-desc">
          A verified bilateral ecosystem bridging global conglomerates, regional market leaders, and bilateral councils across South Korea and the Arab world.
        </p>
      </div>

      <!-- Animated Mouse Scroll Indicator -->
      <a href="#partners" class="cover-mouse" id="coverMouse" aria-label="Scroll to partner directory">
        <span class="mouse-icon"></span>
        <span class="mouse-text">Scroll</span>
      </a>
    </header>

    <!-- 2. Partners Directory Section (Clean White Surface, Amorepacific Style) -->
    <section class="partners-directory" id="partners" aria-labelledby="partners-heading">
      <div class="container">
        <!-- Minimalist Section Header -->
        <div class="directory-intro">
          <h2 id="partners-heading" class="section-title">
            Our Ecosystem.<br /><span>Direct Alliances.</span>
          </h2>
          <p class="section-lead">
            Collaborating with leading enterprises across key industrial verticals to build lasting bilateral value.
          </p>
        </div>

        <!-- Horizontal Category Line Tabs (Amorepacific line-tab) -->
        <nav class="tabs-bar" aria-label="Partner category filter">
          <ul class="tabs-list" role="tablist">
            {filterCategories.map((cat, idx) => (
              <li role="presentation">
                <button
                  type="button"
                  class={`tab-btn ${idx === 0 ? 'is-active' : ''}`}
                  data-filter={cat.id}
                  role="tab"
                  aria-selected={idx === 0 ? 'true' : 'false'}
                >
                  {cat.label}
                </button>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Clean Logo Tiles Grid (Amorepacific identity-list) -->
        <ul class="partners-grid" role="region" aria-label="Partners list">
          {partners.map((partner) => (
            <li class="partner-tile" data-group={partner.filterGroup}>
              <div class="partner-card">
                <div class="partner-card__logo-wrap">
                  <img
                    src={partner.logo}
                    alt={`${partner.name} logo`}
                    width={partner.width}
                    height={partner.height}
                    loading="lazy"
                    decoding="async"
                    class="partner-card__logo"
                  />
                </div>

                <div class="partner-card__meta">
                  <span class="partner-card__category">{partner.category}</span>
                  <h3 class="partner-card__name">{partner.name}</h3>
                </div>

                <!-- Amorepacific Signature Hover Reveal (.thumb-hover) -->
                <div class="partner-card__hover" aria-hidden="true">
                  <span class="hover-category">{partner.category}</span>
                  <span class="hover-name">{partner.name}</span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Closing CTA (Clean & Sober) -->
    <section class="closing-cta" aria-labelledby="cta-heading">
      <div class="container">
        <div class="closing-cta__box">
          <div class="closing-cta__text">
            <h2 id="cta-heading" class="closing-cta__title">Join Our Ecosystem</h2>
            <p class="closing-cta__lead">
              Connect with our executive desk to explore commercial joint ventures and market access.
            </p>
          </div>
          <a href="/contact" class="partner-cta">
            <span>Start a Conversation</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 10h11M11 5l5 5-5 5" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  // ============================================================================
  // Amorepacific Category Filter & Parallax Engine for Partners
  // ============================================================================
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Hero Cover Entrance & Parallax
    const cover = document.getElementById('cover');
    const coverBg = document.getElementById('coverBg');
    const coverContent = document.getElementById('coverContent');
    const coverMouse = document.getElementById('coverMouse');

    if (cover && coverBg) {
      coverBg.classList.add('is-loaded');

      if (window.matchMedia('(min-width: 1024px)').matches) {
        cover.addEventListener('mousemove', (e) => {
          const rect = cover.getBoundingClientRect();
          const x = (e.clientX - rect.width / 2) / (rect.width / 2);
          const y = (e.clientY - rect.height / 2) / (rect.height / 2);
          coverBg.style.transform = `scale(1.05) translate(${x * -18}px, ${y * -12}px)`;
        });

        cover.addEventListener('mouseleave', () => {
          coverBg.style.transform = 'scale(1) translate(0, 0)';
        });
      }
    }

    // Scroll fade-out for hero
    window.addEventListener(
      'scroll',
      () => {
        const scrollY = window.scrollY;
        const fadeThreshold = window.innerHeight * 0.45;

        if (coverContent) {
          const opacity = Math.max(0, 1 - scrollY / fadeThreshold);
          const translateY = scrollY * 0.32;
          coverContent.style.opacity = opacity.toFixed(2);
          coverContent.style.transform = `translateY(${translateY.toFixed(1)}px)`;
        }

        if (coverMouse) {
          coverMouse.style.opacity = Math.max(0, 1 - scrollY / (fadeThreshold * 0.5)).toFixed(2);
        }
      },
      { passive: true }
    );

    // 2. Category Line Tabs Filtering (Amorepacific style)
    const tabBtns = Array.from(document.querySelectorAll('.tab-btn'));
    const tiles = Array.from(document.querySelectorAll('.partner-tile'));

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        const filter = btn.getAttribute('data-filter');

        tiles.forEach((tile) => {
          const group = tile.getAttribute('data-group');
          if (filter === 'all' || group === filter) {
            tile.classList.remove('is-hidden');
          } else {
            tile.classList.add('is-hidden');
          }
        });
      });
    });

    // 3. Smooth scroll on anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

<style>
  /* ==========================================================================
     Strategic Partners - Amorepacific-Inspired Clean & Sober Design
     ========================================================================== */

  .partners-portal {
    position: relative;
    background: var(--color-bg);
  }

  /* --------------------------------------------------------------------------
     1. Hero Cover Section (.cover) - Harmonized Height & Photo Visibility
     -------------------------------------------------------------------------- */
  .cover {
    position: relative;
    height: clamp(440px, 60vh, 540px);
    min-height: 440px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #ffffff;
    overflow: hidden;
  }

  .cover-spacer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .cover-bg {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.06) translateX(25px);
    opacity: 0.85;
    transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.2s ease;
    will-change: transform;
  }

  .cover-bg.is-loaded {
    transform: scale(1) translateX(0);
    opacity: 1;
  }

  /* Subtle overlay: allows photo to be clearly visible */
  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 7, 34, 0.45) 0%,
      rgba(5, 7, 34, 0.3) 50%,
      rgba(5, 7, 34, 0.65) 100%
    );
  }

  .cover-content {
    position: relative;
    z-index: 2;
    max-width: 62rem;
    padding-top: var(--header-height);
    transition: opacity 150ms linear, transform 150ms linear;
    will-change: opacity, transform;
  }

  .breadcrumbs {
    margin-bottom: 2rem;
    animation: fadeInText 0.8s ease backwards 0.2s;
  }

  .breadcrumbs ol {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-right: 0.75rem;
    opacity: 0.4;
  }

  .breadcrumbs a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: #ffffff;
  }

  .breadcrumbs [aria-current="page"] {
    color: #ffffff;
    font-weight: 500;
  }

  .cover-h {
    margin: 0 0 1.5rem;
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #ffffff;
    text-shadow: 0 4px 25px rgba(0, 0, 0, 0.4);
    text-wrap: balance;
    animation: fadeInText 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards 0.4s;
  }

  .cover-desc {
    margin: 0;
    font-size: clamp(1.125rem, 1.5vw, 1.35rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.92);
    max-width: 48rem;
    font-weight: 300;
    text-wrap: pretty;
    animation: fadeInText 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards 0.6s;
  }

  @keyframes fadeInText {
    0% {
      opacity: 0;
      transform: translateY(22px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mouse Scroll Indicator */
  .cover-mouse {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    transition: color 200ms ease, opacity 200ms ease;
    animation: fadeInText 1s ease backwards 1s;
  }

  .cover-mouse:hover {
    color: #ffffff;
  }

  .mouse-icon {
    width: 22px;
    height: 36px;
    border: 1.8px solid rgba(255, 255, 255, 0.65);
    border-radius: 12px;
    position: relative;
  }

  .mouse-icon::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    width: 3.5px;
    height: 7px;
    background: #ffffff;
    border-radius: 2px;
    transform: translateX(-50%);
    animation: mouseWheel 2s infinite cubic-bezier(0.65, 0, 0.35, 1);
  }

  .mouse-text {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }

  @keyframes mouseWheel {
    0% {
      transform: translate(-50%, 0);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, 14px);
      opacity: 0;
    }
  }

  /* --------------------------------------------------------------------------
     2. Directory Section (White Surface, Amorepacific line-tab & identity-list)
     -------------------------------------------------------------------------- */
  .partners-directory {
    padding-block: clamp(4.5rem, 7vw, 6.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .directory-intro {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .section-title {
    margin: 0;
    font-size: clamp(2.25rem, 3.8vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--color-text);
  }

  .section-title span {
    color: var(--color-primary);
  }

  .section-lead {
    margin: 0;
    font-size: clamp(1.05rem, 1.4vw, 1.225rem);
    line-height: 1.75;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* Horizontal Category Line Tabs (Amorepacific line-tab) */
  .tabs-bar {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs-bar::-webkit-scrollbar {
    display: none;
  }

  .tabs-list {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: max-content;
  }

  .tab-btn {
    position: relative;
    padding: 0.85rem 0.25rem 1.15rem;
    background: none;
    border: none;
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    font-weight: 500;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 220ms ease;
    white-space: nowrap;
  }

  .tab-btn::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tab-btn:hover {
    color: var(--color-text);
  }

  .tab-btn.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .tab-btn.is-active::after {
    transform: scaleX(1);
  }

  /* Clean Logo Tiles Grid (Amorepacific identity-list) */
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partner-tile {
    position: relative;
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .partner-tile.is-hidden {
    display: none;
  }

  .partner-card {
    position: relative;
    height: 220px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 1.5rem;
    overflow: hidden;
    transition: border-color 240ms ease, box-shadow 240ms ease, transform 240ms ease;
  }

  .partner-card:hover {
    border-color: rgba(0, 14, 138, 0.35);
    box-shadow: 0 12px 32px -8px rgba(10, 18, 48, 0.1);
    transform: translateY(-3px);
  }

  .partner-card__logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    width: 100%;
  }

  .partner-card__logo {
    max-width: 180px;
    max-height: 65px;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 300ms ease;
  }

  .partner-card:hover .partner-card__logo {
    transform: scale(1.04);
  }

  .partner-card__meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    width: 100%;
    border-top: 1px solid var(--color-surface-soft);
  }

  .partner-card__category {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 500;
  }

  .partner-card__name {
    margin: 2px 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: center;
    letter-spacing: -0.01em;
  }

  /* Amorepacific Signature Hover Reveal (.thumb-hover) */
  .partner-card__hover {
    position: absolute;
    inset: 0;
    background: #09102c;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease;
  }

  @media (hover: hover) {
    .partner-card:hover .partner-card__hover {
      opacity: 0.96;
    }
  }

  .hover-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8da4ff;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .hover-name {
    font-size: 1.2rem;
    font-weight: 600;
    text-align: center;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  /* --------------------------------------------------------------------------
     3. Closing CTA Section (Clean & Sober)
     -------------------------------------------------------------------------- */
  .closing-cta {
    padding-block: clamp(5rem, 8vw, 7.5rem);
    background: var(--color-surface);
  }

  .closing-cta__box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .closing-cta__title {
    margin: 0 0 0.85rem;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--color-text);
  }

  .closing-cta__lead {
    margin: 0;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 42rem;
  }

  .partner-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.85rem;
    background: var(--color-primary);
    color: #ffffff;
    border-radius: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: background-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
    box-shadow: 0 4px 14px rgba(0, 14, 138, 0.16);
  }

  .partner-cta:hover {
    background: var(--color-secondary);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 14, 138, 0.25);
  }

  .cta-arrow {
    width: 18px;
    height: 18px;
    transition: transform 220ms ease;
  }

  .partner-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* --------------------------------------------------------------------------
     Responsive Adaptations
     -------------------------------------------------------------------------- */
  @media (max-width: 1023px) {
    .directory-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .partners-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .closing-cta__box {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .cover {
      height: auto;
      min-height: auto;
      padding-top: calc(var(--header-height) + 2rem);
      padding-bottom: 4rem;
    }

    .partners-grid {
      grid-template-columns: 1fr;
    }

    .partner-card {
      height: 190px;
    }

    .partner-cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-bg,
    .partner-card,
    .partner-card__logo,
    .partner-card__hover,
    .partner-cta,
    .cta-arrow {
      transition: none !important;
      transform: none !important;
    }

    .mouse-icon::before {
      animation: none !important;
    }
  }
</style>
