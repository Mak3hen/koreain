---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Global Markets & Bilateral Reach | KoreaIN"
  description="Explore KoreaIN's international reach—connecting South Korea with Saudi Arabia, the Middle East, and global high-growth economic corridors."
>
  <main id="main-content" class="page-markets">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Global Markets</li>
          </ol>
        </nav>

        <div class="page-hero__grid">
          <div class="page-hero__text">
            <h1 class="page-title">From South Korea to Global Growth Corridors</h1>
            <p class="page-lead">
              KoreaIN creates a transparent, high-trust pathway between Korean industrial and technological leadership and fast-transforming international markets, with a dedicated bilateral anchor in Saudi Arabia and the GCC.
            </p>
            <div class="hero-actions">
              <a href="/contact" class="button button--primary">
                <span>Inquire About Market Entry</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 10h11M11 5l5 5-5 5" />
                </svg>
              </a>
              <a href="/business-areas" class="button button--secondary">
                <span>Explore Sectors</span>
              </a>
            </div>
          </div>

          <div class="page-hero__stats">
            <div class="stat-card">
              <span class="stat-card__number">Seoul</span>
              <span class="stat-card__label">Headquarters &amp; Korean Ecosystem Hub</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Riyadh</span>
              <span class="stat-card__label">GCC &amp; Saudi Vision 2030 Anchor</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">6 GCC Nations</span>
              <span class="stat-card__label">Active Regional Distribution Reach</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Global</span>
              <span class="stat-card__label">Cross-Border Trade Corridors</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Map Stage & Visual Stage -->
    <section class="section map-section">
      <div class="container">
        <div class="market-geography-card">
          <div class="market-geography-header">
            <div>
              <h2 class="market-geography-title">The Bilateral Vector</h2>
            </div>
            <span class="market-badge">Seoul ↔ Riyadh Corridor</span>
          </div>

          <!-- Dynamic SVG Map Silhouette -->
          <div class="market-geography" aria-hidden="true">
            <svg class="market-geography__desktop" viewBox="0 0 800 500" fill="none" focusable="false">
              <defs>
                <mask id="markets-region" maskUnits="userSpaceOnUse" x="0" y="0" width="800" height="500" style="mask-type: alpha">
                  <image href="/home/markets/middle-east.svg" x="-40" y="45" width="510" height="340" />
                </mask>
                <mask id="markets-korea" maskUnits="userSpaceOnUse" x="0" y="0" width="800" height="500" style="mask-type: alpha">
                  <image href="/home/markets/south-korea.svg" x="425" y="0" width="320" height="400" />
                </mask>
                <mask id="markets-saudi" maskUnits="userSpaceOnUse" x="0" y="0" width="800" height="500" style="mask-type: alpha">
                  <image href="/home/markets/saudi-arabia.svg" x="65" y="225" width="285" height="244" />
                </mask>
              </defs>
              <rect width="800" height="500" fill="#24395b" mask="url(#markets-region)" />
              <path d="M210 342C275 118 455 85 610 168" stroke="#769cdc" stroke-width="2" stroke-dasharray="6 4" />
              <rect width="800" height="500" fill="#3868aa" mask="url(#markets-saudi)" />
              <rect width="800" height="500" fill="#9dbfff" mask="url(#markets-korea)" />
              <circle cx="210" cy="342" r="14" stroke="#a8c5f6" stroke-width="1.5" />
              <circle cx="210" cy="342" r="6" fill="#f7f8fc" />
              <circle cx="610" cy="168" r="18" stroke="#f7f8fc" stroke-width="1.5" />
              <circle cx="610" cy="168" r="7" fill="#000e8a" stroke="#f7f8fc" stroke-width="2" />
              <path d="M610 188V315H674M210 357V474H114" stroke="#718ab0" stroke-width="1" />
            </svg>
          </div>
        </div>

        <!-- Black Rectangle Placeholder for International Presence -->
        <div class="black-placeholder" aria-label="Regional offices placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">Regional Operations Hubs &amp; Bilateral Trade Delegations — Pending Photography</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Regional Nodes -->
    <section class="section nodes-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Core Regional Ecosystems</h2>
          <p class="section-copy">
            We focus operational resources where bilateral synergies yield the highest commercial velocity.
          </p>
        </header>

        <div class="nodes-grid">
          <article class="node-card">
            <div class="node-card__header">
              <span class="node-card__location">East Asia</span>
              <h3 class="node-card__title">South Korea</h3>
              <p class="node-card__role">Home Base &amp; Technological Innovation Engine</p>
            </div>
            <div class="node-card__body">
              <p>
                Headquartered in Seoul, KoreaIN maintains daily operational proximity with leading Korean conglomerates, venture technology incubators, public research institutions, and certified manufacturing laboratories.
              </p>
              <ul class="node-card__list">
                <li>Direct access to KOSDAQ &amp; tech venture leadership</li>
                <li>Semiconductor, AI, and mobility supplier networks</li>
                <li>Liaison with Korean trade councils and export bodies</li>
              </ul>
            </div>
          </article>

          <article class="node-card">
            <div class="node-card__header">
              <span class="node-card__location">Middle East</span>
              <h3 class="node-card__title">Kingdom of Saudi Arabia</h3>
              <p class="node-card__role">Anchor Transformation Market &amp; Giga-Projects</p>
            </div>
            <div class="node-card__body">
              <p>
                As an affiliated participant in the Saudi-Korea Business Council, KoreaIN bridges Korean advanced technology with the Vision 2030 industrial diversification framework across Riyadh, Jeddah, and the Eastern Province.
              </p>
              <ul class="node-card__list">
                <li>Giga-project infrastructure &amp; smart city solutions</li>
                <li>Commercial joint ventures with Saudi family conglomerates</li>
                <li>SFDA compliance and national distribution agreements</li>
              </ul>
            </div>
          </article>

          <article class="node-card">
            <div class="node-card__header">
              <span class="node-card__location">Gulf Region</span>
              <h3 class="node-card__title">Wider GCC &amp; Arab Markets</h3>
              <p class="node-card__role">Regional Distribution &amp; Capital Corridors</p>
            </div>
            <div class="node-card__body">
              <p>
                Extending bilateral impact across the United Arab Emirates, Qatar, Kuwait, Bahrain, and Oman—facilitating cross-border retail distribution, regional headquarters setups, and institutional co-investments.
              </p>
              <ul class="node-card__list">
                <li>Regional e-commerce &amp; pharmacy chain placement</li>
                <li>Free zone incorporation &amp; logistics routing</li>
                <li>Sovereign and institutional LP syndication</li>
              </ul>
            </div>
          </article>

          <article class="node-card">
            <div class="node-card__header">
              <span class="node-card__location">Worldwide</span>
              <h3 class="node-card__title">Global Expansion Corridors</h3>
              <p class="node-card__role">Selective International Collaborations</p>
            </div>
            <div class="node-card__body">
              <p>
                Collaborating with strategic partners across Europe, Southeast Asia, and North America to support multi-regional tech transfers and bilateral supply chain resiliency.
              </p>
              <ul class="node-card__list">
                <li>Tripartite trade structuring (Korea - GCC - Global)</li>
                <li>International intellectual property licensing</li>
                <li>Global institutional investor relationships</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Ready to Expand Across Our Corridors?</h2>
          <p class="cta-card__copy">
            Speak with our international advisory team to design your cross-border roadmap between Korea and global markets.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Contact Global Desk</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/business-areas" class="button button--secondary">
              <span>View Business Areas</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-actions svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .page-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 8rem;
  }

  .stat-card__number {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .stat-card__label {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* Map Section */
  .map-section {
    padding-top: clamp(2.5rem, 4.5vw, 4rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  .market-geography-card {
    background: #080b2a;
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    margin-bottom: 3.5rem;
  }

  .market-geography-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }


  .market-geography-title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0.5rem 0 0;
    letter-spacing: -0.025em;
  }

  .market-badge {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a6b8ff;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(166, 184, 255, 0.35);
    background: rgba(166, 184, 255, 0.08);
  }

  .market-geography {
    width: 100%;
    max-width: 58rem;
    margin: 0 auto;
  }

  .market-geography svg {
    width: 100%;
    height: auto;
  }

  .black-placeholder {
    width: 100%;
    aspect-ratio: 21 / 8;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }

  .black-placeholder__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  .black-placeholder__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .black-placeholder__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .black-placeholder__note {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 26rem;
  }

  /* Nodes Section */
  .section-header {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .nodes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .node-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 3.5vw, 2.75rem);
    box-shadow: var(--shadow-card);
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .node-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-secondary) 40%, var(--color-border));
  }

  .node-card__location {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-secondary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .node-card__title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .node-card__role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }

  .node-card__body p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .node-card__list {
    padding-left: 1.2rem;
    margin: 0;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }

  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .page-hero__grid,
    .nodes-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .page-hero__stats {
      grid-template-columns: 1fr;
    }
  }
</style>