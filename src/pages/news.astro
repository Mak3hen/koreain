---
import BaseLayout from '../layouts/BaseLayout.astro';

const newsArticles = [
  {
    category: 'KoreaIN Updates',
    date: 'November 2026',
    title: 'KoreaIN Expands Global Investment & Bilateral Advisory Operations',
    description: 'In response to accelerated capital allocation across the Korea-GCC corridor, KoreaIN inaugurates its dedicated Global Investment & Venture Advisory practice.',
    readTime: '4 min read',
    isSpotlight: true
  },
  {
    category: 'Market Insights',
    date: 'October 2026',
    title: 'Bridging Korean AI Semiconductors with Saudi Vision 2030 Mega-Projects',
    description: 'An executive analysis on how next-generation Korean NPU hardware and cognitive robotics are establishing high-efficiency data infrastructure in the Middle East.',
    readTime: '6 min read',
    isSpotlight: false
  },
  {
    category: 'Clean Mobility',
    date: 'September 2026',
    title: 'Fleet Decarbonization: Korea’s EV Supply Chains Meet Gulf Transit Initiatives',
    description: 'Strategic opportunities in battery management systems, alternative fuels, and heavy commercial vehicle electrification across regional transport corridors.',
    readTime: '5 min read',
    isSpotlight: false
  },
  {
    category: 'Consumer Innovation',
    date: 'August 2026',
    title: 'K-Beauty Formulation Dynamics: Adapting Clinical Skincare for GCC Climates',
    description: 'How Korean OEM/ODM laboratories are engineering barrier-repair active formulas and achieving rapid SFDA clearance for leading Gulf retail platforms.',
    readTime: '4 min read',
    isSpotlight: false
  },
  {
    category: 'Bilateral Trade',
    date: 'July 2026',
    title: 'Saudi-Korea Business Council Convenes Seoul Bilateral Industry Dialogue',
    description: 'Executive proceedings on direct Foreign Direct Investment (FDI), cross-border joint venture frameworks, and specialized economic zone integration.',
    readTime: '5 min read',
    isSpotlight: false
  },
  {
    category: 'Venture Capital',
    date: 'June 2026',
    title: 'Cross-Border LP/GP Synergies: Institutional Capital Flow into Korean Tech',
    description: 'Examining co-investment vehicles and sovereign fund participation in Korean Series A through Pre-IPO deep tech innovators.',
    readTime: '7 min read',
    isSpotlight: false
  }
];
---

<BaseLayout
  title="News & Insights | KoreaIN"
  description="Verified company updates, bilateral market analysis, and executive insights from KoreaIN across Korea, Saudi Arabia, and international business corridors."
>
  <main id="main-content" class="page-news">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">News</li>
          </ol>
        </nav>

        <div class="page-hero__content">
          <h1 class="page-title">Latest News &amp; Insights</h1>
          <p class="page-lead">
            Stay informed with verified KoreaIN announcements, strategic analyses of the Korea-GCC commercial corridor, and sector-by-sector briefings across deep tech, mobility, capital, and consumer innovation.
          </p>
        </div>
      </div>
    </header>

    <!-- Spotlight Article & Black Placeholder Hero -->
    <section class="section spotlight-section">
      <div class="container">
        <div class="spotlight-card">
          <div class="spotlight-visual" aria-hidden="true">
            <div class="spotlight-graphic">
              <span class="spotlight-graphic__index">01</span>
              <span class="spotlight-graphic__badge">Featured Release</span>
              <span class="spotlight-graphic__ring"></span>
            </div>
          </div>

          <div class="spotlight-body">
            <div class="spotlight-meta">
              <span class="spotlight-category">Featured Announcement</span>
              <span aria-hidden="true">•</span>
              <span>November 2026</span>
            </div>
            <h2 class="spotlight-title">KoreaIN Expands Global Investment &amp; Bilateral Advisory Operations</h2>
            <p class="spotlight-desc">
              Reflecting the accelerating depth of bilateral commercial commitments between South Korea and the GCC, KoreaIN has formally expanded its sector mandate into cross-border investment advisory and sovereign fund facilitation.
            </p>
            <div class="spotlight-footer">
              <span class="spotlight-time">4 min read</span>
              <a href="/business-areas/investment" class="button button--primary">
                <span>Explore Investment Practice</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 10h11M11 5l5 5-5 5" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- News Grid -->
    <section class="section articles-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">All Publications</h2>
        </header>

        <div class="news-grid">
          {
            newsArticles.map((article, index) => (
              <article class="article-card">
                <div class={`article-card__visual article-card__visual--${(index % 3) + 1}`} aria-hidden="true">
                  <span class="article-card__visual-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="article-card__visual-ring"></span>
                </div>
                <div class="article-card__body">
                  <div class="article-card__meta">
                    <span class="article-card__category">{article.category}</span>
                    <span aria-hidden="true">—</span>
                    <span>{article.date}</span>
                  </div>
                  <h3 class="article-card__title">{article.title}</h3>
                  <p class="article-card__desc">{article.description}</p>
                  <div class="article-card__footer">
                    <span class="article-card__time">{article.readTime}</span>
                    <a href="/contact" class="arrow-link article-card__link">
                      <span>Inquire / Brief</span>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10h11M11 5l5 5-5 5" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Interested in Research Collaborations?</h2>
          <p class="cta-card__copy">
            Contact our editorial and bilateral research team for media inquiries, market reports, or speaking engagements.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Contact Communications Desk</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/" class="button button--secondary">
              <span>Back to Homepage</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }

  /* Spotlight Section */
  .spotlight-section {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .spotlight-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3.5rem);
    box-shadow: var(--shadow-card);
  }

  .spotlight-visual {
    width: 100%;
  }

  .spotlight-graphic {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: linear-gradient(140deg, #0047a0 0%, #000e8a 60%, #050722 100%);
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 14, 138, 0.25);
    display: flex;
    align-items: flex-end;
    padding: 1.75rem;
  }

  .spotlight-graphic::before {
    position: absolute;
    top: -30%;
    right: -15%;
    width: 80%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    content: '';
  }

  .spotlight-graphic::after {
    position: absolute;
    bottom: -20%;
    left: -10%;
    width: 50%;
    aspect-ratio: 1;
    background: rgba(205, 46, 58, 0.35);
    border-radius: 50%;
    filter: blur(40px);
    content: '';
  }

  .spotlight-graphic__index {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.85);
  }

  .spotlight-graphic__ring {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
  }

  .spotlight-graphic__badge {
    position: relative;
    z-index: 1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .spotlight-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .spotlight-category {
    color: var(--color-accent);
  }

  .spotlight-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .spotlight-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .spotlight-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .spotlight-time {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .spotlight-footer svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* Articles Section */
  .section-header {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-secondary) 35%, var(--color-border));
  }

  .article-card__visual {
    position: relative;
    height: 11rem;
    overflow: hidden;
    background: #07113e;
  }

  .article-card__visual::before {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    content: '';
  }

  .article-card__visual--1 {
    background: linear-gradient(140deg, #0047a0 0%, #000e8a 80%);
  }
  .article-card__visual--1::before {
    top: -30%;
    right: -15%;
  }

  .article-card__visual--2 {
    background: linear-gradient(145deg, #11173e 10%, #0047a0 120%);
  }
  .article-card__visual--2::before {
    bottom: -35%;
    right: -10%;
  }

  .article-card__visual--3 {
    background: linear-gradient(145deg, #000e8a 0%, #121638 85%);
  }
  .article-card__visual--3::before {
    top: -25%;
    left: -15%;
  }

  .article-card__visual-num {
    position: absolute;
    bottom: 1rem;
    left: 1.25rem;
    z-index: 1;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .article-card__visual-ring {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    z-index: 1;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
  }

  .article-card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.85rem;
  }

  .article-card__category {
    color: var(--color-secondary);
  }

  .article-card__title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .article-card__desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .article-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .article-card__time {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .article-card__link {
    font-size: 0.8125rem;
  }

  .article-card__link svg {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    stroke-width: 1.7;
    fill: none;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }


  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .spotlight-card {
      grid-template-columns: 1fr;
    }

    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>