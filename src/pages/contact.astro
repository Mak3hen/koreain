---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | KoreaIN"
  description="Connect with KoreaIN's executive advisory, sector specialists, and cross-border teams across Seoul, Riyadh, and global markets."
>
  <main id="main-content" class="page-contact">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Contact Us</li>
          </ol>
        </nav>

        <div class="page-hero__content">
          <h1 class="page-title">Start a Conversation with KoreaIN</h1>
          <p class="page-lead">
            Whether you are exploring market entry into Korea, seeking verified technology partners, or architecting bilateral investment opportunities across the Middle East, our executive advisory team is ready to assist.
          </p>
        </div>
      </div>
    </header>

    <!-- Contact Grid: Form & Info -->
    <section class="section contact-section">
      <div class="container contact-grid">
        <!-- Inquiry Form -->
        <div class="contact-form-card">
          <h2 class="contact-card-title">Send a Strategic Inquiry</h2>
          <p class="contact-card-sub">
            Complete the form below and an advisory director will review your brief within one business day.
          </p>

          <form class="contact-form" id="contact-form" action="#" method="POST">
            <div class="form-row form-row--two">
              <div class="form-group">
                <label for="full-name">Full Name *</label>
                <input type="text" id="full-name" name="name" required placeholder="Your full name" />
              </div>
              <div class="form-group">
                <label for="email-address">Corporate Email *</label>
                <input type="email" id="email-address" name="email" required placeholder="name@company.com" />
              </div>
            </div>

            <div class="form-row form-row--two">
              <div class="form-group">
                <label for="company-name">Organization / Entity *</label>
                <input type="text" id="company-name" name="company" required placeholder="Company or Fund name" />
              </div>
              <div class="form-group">
                <label for="phone-number">Phone Number (with country code)</label>
                <input type="tel" id="phone-number" name="phone" placeholder="+82 or +966..." />
              </div>
            </div>

            <div class="form-row form-row--two">
              <div class="form-group">
                <label for="sector-interest">Primary Sector *</label>
                <select id="sector-interest" name="sector" required>
                  <option value="" disabled selected>Select an area of interest</option>
                  <option value="consultation">Strategic Consultation &amp; Market Entry</option>
                  <option value="ai">Artificial Intelligence &amp; Deep Tech</option>
                  <option value="automotive">Automotive &amp; Clean Mobility</option>
                  <option value="investment">Investment &amp; Venture Capital</option>
                  <option value="beauty">K-Beauty &amp; Bio-Cosmetics</option>
                  <option value="general">Bilateral Trade Council &amp; General Partnership</option>
                </select>
              </div>
              <div class="form-group">
                <label for="geographic-region">Your Location / Region *</label>
                <select id="geographic-region" name="region" required>
                  <option value="" disabled selected>Select primary region</option>
                  <option value="korea">South Korea</option>
                  <option value="saudi">Saudi Arabia</option>
                  <option value="gcc">Other GCC / Middle East</option>
                  <option value="asia">Asia-Pacific</option>
                  <option value="europe">Europe</option>
                  <option value="americas">North &amp; South America</option>
                  <option value="other">Other International</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="project-scope">Project Scope &amp; Objectives *</label>
              <textarea
                id="project-scope"
                name="message"
                rows="5"
                required
                placeholder="Please outline your objectives, anticipated timelines, and how KoreaIN can assist your bilateral expansion."
              ></textarea>
            </div>

            <button type="submit" class="button button--primary submit-btn">
              <span>Submit Confidential Inquiry</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </button>
            <p class="form-privacy-note">
              All communications are held in strict institutional confidence. We do not disclose client information to third parties.
            </p>
          </form>
        </div>

        <!-- Contact Directory & Office Cards -->
        <div class="contact-info-col">
          <div class="office-card">
            <span class="office-card__badge">Headquarters</span>
            <h3 class="office-card__city">Seoul, South Korea</h3>
            <p class="office-card__region">East Asia Operations Hub</p>
            <address class="office-card__address">
              Teheran-ro, Gangnam-gu<br />
              Seoul 06158, Republic of Korea
            </address>
            <div class="office-card__channels">
              <p><strong>Email:</strong> <a href="mailto:korea@korea-in.com">korea@korea-in.com</a></p>
              <p><strong>Hours:</strong> Mon–Fri, 09:00–18:00 KST (GMT+9)</p>
            </div>
          </div>

          <div class="office-card">
            <span class="office-card__badge">Middle East Hub</span>
            <h3 class="office-card__city">Riyadh, Kingdom of Saudi Arabia</h3>
            <p class="office-card__region">GCC &amp; Vision 2030 Anchor</p>
            <address class="office-card__address">
              King Fahd Road, Al Olaya<br />
              Riyadh 12213, Kingdom of Saudi Arabia
            </address>
            <div class="office-card__channels">
              <p><strong>Email:</strong> <a href="mailto:info@korea-in.com">info@korea-in.com</a></p>
              <p><strong>Hours:</strong> Sun–Thu, 09:00–18:00 AST (GMT+3)</p>
            </div>
          </div>

          <div class="direct-channels-card">
            <h4>Direct Institutional Channels</h4>
            <ul class="direct-channels-list">
              <li>
                <span>General Inquiries:</span>
                <a href="mailto:info@korea-in.com">info@korea-in.com</a>
              </li>
              <li>
                <span>Korea Operations:</span>
                <a href="mailto:korea@korea-in.com">korea@korea-in.com</a>
              </li>
              <li>
                <span>Leadership Office:</span>
                <a href="mailto:yaser@korea-in.com">yaser@korea-in.com</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    contactForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for reaching out to KoreaIN. Our team will contact you shortly.');
      contactForm.reset();
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }

  /* Contact Grid */
  .contact-section {
    background: var(--color-bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .contact-form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 4vw, 3.5rem);
    box-shadow: var(--shadow-card);
  }

  .contact-card-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .contact-card-sub {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row--two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: 0.95rem;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 14, 138, 0.12);
    outline: none;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .submit-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .form-privacy-note {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Info Column */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .office-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .office-card__badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--color-surface-soft);
    margin-bottom: 0.75rem;
  }

  .office-card__city {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
    letter-spacing: -0.015em;
  }

  .office-card__region {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .office-card__address {
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .office-card__channels p {
    margin: 0.35rem 0;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .office-card__channels a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .office-card__channels a:hover {
    color: var(--color-secondary);
  }

  .direct-channels-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
  }

  .direct-channels-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .direct-channels-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.875rem;
  }

  .direct-channels-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-border);
  }

  .direct-channels-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .direct-channels-list a {
    color: var(--color-interactive);
    font-weight: 600;
  }

  .direct-channels-list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 63.99rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .form-row--two {
      grid-template-columns: 1fr;
    }
  }
</style>