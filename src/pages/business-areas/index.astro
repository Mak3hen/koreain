---
import BaseLayout from '../../layouts/BaseLayout.astro';

const areaDetails = [
  {
    num: '01',
    title: 'Consultation',
    slug: 'consultation',
    href: '/business-areas/consultation',
    tag: 'Strategic Advisory',
    description: 'Comprehensive market entry, regulatory strategy, and bilateral partnership advisory for global enterprises entering Korea and Korean companies expanding abroad.',
    image: '/home/business-areas/consultation.webp',
    isPlaceholder: false,
    keyMetrics: '360° Entry Strategy • Due Diligence • Government Liaison'
  },
  {
    num: '02',
    title: 'Artificial Intelligence',
    slug: 'artificial-intelligence',
    href: '/business-areas/artificial-intelligence',
    tag: 'Deep Tech & Compute',
    description: 'Connecting enterprise needs with Korea\'s advanced artificial intelligence ecosystem, NPU semiconductor innovations, computer vision, and robotics.',
    image: '/home/business-areas/ai.webp',
    isPlaceholder: false,
    keyMetrics: 'Industrial AI • Digital Twins • Hardware Acceleration'
  },
  {
    num: '03',
    title: 'Automotive',
    slug: 'automotive',
    href: '/business-areas/automotive',
    tag: 'Clean Mobility',
    description: 'Accelerating international partnerships across Korea\'s tier-1 automotive manufacturing, electric vehicle ecosystems, battery supply chains, and smart mobility.',
    image: '/home/business-areas/automotive.webp',
    isPlaceholder: false,
    keyMetrics: 'EV Platforms • Battery Supply Chains • Fleet Transit'
  },
  {
    num: '04',
    title: 'Investment',
    slug: 'investment',
    href: '/business-areas/investment',
    tag: 'Strategic Capital',
    description: 'Mobilizing cross-border capital, sovereign wealth funds, and venture investments between Korea, Saudi Arabia, the GCC, and global financial hubs.',
    image: '',
    isPlaceholder: true,
    keyMetrics: 'Venture Co-Investment • Sovereign Advisory • FDI SPVs'
  },
  {
    num: '05',
    title: 'Beauty',
    slug: 'beauty',
    href: '/business-areas/beauty',
    tag: 'Bio-Cosmetics',
    description: 'Connecting top-tier Korean skincare brands, bio-cosmetic manufacturers, and OEM/ODM laboratories with high-growth international consumer markets.',
    image: '/home/business-areas/beauty.webp',
    isPlaceholder: false,
    keyMetrics: 'OEM/ODM Laboratories • SFDA Compliance • GCC Distribution'
  }
];
---

<BaseLayout
  title="Our Business Areas | KoreaIN"
  description="Explore KoreaIN's five specialized business areas: Strategic Consultation, Artificial Intelligence, Automotive, Global Investment, and K-Beauty Innovation."
>
  <main id="main-content" class="page-business-areas">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Business Areas</li>
          </ol>
        </nav>

        <div class="page-hero__content">
          <h1 class="page-title">Specialized Verticals of Excellence</h1>
          <p class="page-lead">
            KoreaIN concentrates bilateral focus on five core high-growth domains where South Korea holds undisputed technological, industrial, and creative leadership.
          </p>
        </div>
      </div>
    </header>

    <!-- Sectors List -->
    <section class="section sectors-section">
      <div class="container">
        <div class="sectors-stack">
          {
            areaDetails.map((area) => (
              <article class="sector-row">
                <div class="sector-row__visual">
                  {area.isPlaceholder || !area.image ? (
                    <div class="sector-placeholder" aria-label="Visual placeholder">
                      <div class="sector-placeholder__badge">
                        <span class="sector-placeholder__dot"></span>
                        <span>Visual Placeholder</span>
                      </div>
                    </div>
                  ) : (
                    <img
                      src={area.image}
                      alt={area.title}
                      loading="lazy"
                      decoding="async"
                      class="sector-row__img"
                    />
                  )}
                  <span class="sector-row__num">{area.num}</span>
                </div>

                <div class="sector-row__content">
                  <span class="sector-row__tag">{area.tag}</span>
                  <h2 class="sector-row__title">{area.title}</h2>
                  <p class="sector-row__desc">{area.description}</p>
                  <p class="sector-row__metrics">{area.keyMetrics}</p>
                  <a href={area.href} class="arrow-link sector-row__link">
                    <span>Explore {area.title} Details</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M4 10h11M11 5l5 5-5 5" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Cross-Sector Synergy Stage with Black Rectangle -->
    <section class="section synergy-section">
      <div class="container">
        <div class="black-placeholder" aria-label="Cross-sector synergy placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">Cross-Sector Bilateral Convergence Matrix — Photography Pending</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Have a Cross-Sector Project in Mind?</h2>
          <p class="cta-card__copy">
            KoreaIN integrates multiple practice areas to support multi-faceted joint ventures, FDI establishments, and technology procurement.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Initiate Strategic Discussion</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/about" class="button button--secondary">
              <span>Learn About Our Company</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0;
  }

  /* Sectors Stack */
  .sectors-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .sector-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(2rem, 4vw, 3rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .sector-row:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-secondary) 35%, var(--color-border));
  }

  .sector-row__visual {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000000;
  }

  .sector-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sector-placeholder {
    width: 100%;
    height: 100%;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sector-placeholder__badge {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px dashed rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sector-placeholder__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .sector-row__num {
    position: absolute;
    bottom: 1rem;
    left: 1.25rem;
    font-size: 1.25rem;
    font-weight: 750;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .sector-row__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .sector-row__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .sector-row__desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .sector-row__metrics {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1.75rem;
  }

  .sector-row__link {
    font-size: 0.9375rem;
  }

  .sector-row__link svg {
    width: 1.15rem;
    height: 1.15rem;
    stroke: currentColor;
    stroke-width: 1.7;
    fill: none;
  }

  /* Synergy Section */
  .black-placeholder {
    width: 100%;
    aspect-ratio: 21 / 8;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }

  .black-placeholder__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  .black-placeholder__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .black-placeholder__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .black-placeholder__note {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 26rem;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }


  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .sector-row {
      grid-template-columns: 1fr;
    }
  }
</style>