---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Investment & Venture Advisory | KoreaIN"
  description="Connecting international capital, sovereign wealth funds, and venture investors with Korea's most innovative companies and strategic cross-border opportunities."
>
  <main id="main-content" class="page-investment">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li><a href="/business-areas">Business Areas</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Investment</li>
          </ol>
        </nav>

        <div class="page-hero__grid">
          <div class="page-hero__text">
            <h1 class="page-title">Global Investment &amp; Venture Advisory</h1>
            <p class="page-lead">
              KoreaIN mobilizes cross-border capital, sovereign wealth funds, and private equity to back high-impact Korean technological breakthroughs and strategic bilateral joint ventures between Korea, Saudi Arabia, the GCC, and international markets.
            </p>
            <div class="hero-actions">
              <a href="/contact" class="button button--primary">
                <span>Discuss Investment Opportunities</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 10h11M11 5l5 5-5 5" />
                </svg>
              </a>
              <a href="/business-areas" class="button button--secondary">
                <span>All Business Areas</span>
              </a>
            </div>
          </div>

          <div class="page-hero__stats">
            <div class="stat-card">
              <span class="stat-card__number">Bilateral</span>
              <span class="stat-card__label">Korea - GCC &amp; Global Capital Flow</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Tier-1</span>
              <span class="stat-card__label">Access to Korean Tech Ecosystem</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Vision 2030</span>
              <span class="stat-card__label">Aligned Strategic Synergies</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">End-to-End</span>
              <span class="stat-card__label">Due Diligence &amp; JV Structuring</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Panoramic Showcase (Replacing the Card Look) -->
    <section class="section visual-section" aria-label="Strategic Capital Showcase">
      <div class="container">
        <div class="panoramic-showcase">
          <div class="panoramic-showcase__media">
            <img
              src="/home/business-areas/invest-5-1600.webp"
              alt="Modern financial district corporate skyscrapers and investment headquarters in Seoul."
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
              class="panoramic-img"
            />
            <div class="panoramic-overlay" aria-hidden="true"></div>
            <div class="panoramic-caption">
              <div class="panoramic-info">
                <span class="panoramic-eyebrow">Strategic Capital Deployment</span>
                <p class="panoramic-headline">Seoul Financial Headquarters &amp; Cross-Border Scale</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategic Narrative -->
    <section class="section strategic-overview">
      <!-- Discreet Cloud Trademark Watermark -->
      <div class="cloud-trademark-decor cloud-trademark-decor--left" aria-hidden="true">
        <svg viewBox="0 0 500 280" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M120 210c-38 0-70-26-70-60 0-31 25-57 58-60 6-40 45-72 92-72 25 0 48 9 64 24 17-35 55-58 100-58 58 0 106 41 110 94 25 4 44 25 44 50 0 29-25 52-56 52H120z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M180 210c0-26 22-48 50-48 18 0 34 9 43 24 11-21 34-36 60-36 36 0 64 26 68 60" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M85 160c-18 0-33-13-33-30 0-16 13-28 30-30 3-20 23-36 46-36 12 0 24 4 32 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M220 85c22-30 60-38 90-22s38 52 22 75-52 38-75 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="270" cy="115" r="4" fill="currentColor"/>
        </svg>
      </div>

      <div class="container">
        <div class="split-overview">
          <div class="split-overview__lead">
            <h2 class="section-title">Catalyzing Bilateral Capital Allocation</h2>
          </div>
          <div class="split-overview__body">
            <p class="section-copy">
              South Korea has emerged as one of the world's most concentrated hubs for deep-tech patents, advanced hardware, semiconductor manufacturing, and consumer product breakthroughs. Concurrently, sovereign wealth funds, family offices, and institutional allocators across the Middle East and worldwide are actively seeking sustainable technology transfer, localized industrialization, and venture-grade returns.
            </p>
            <p class="section-copy">
              KoreaIN bridges this critical divide. Moving beyond traditional brokerage, we operate as an institutional catalyst—identifying vetted investment targets, structuring co-investment vehicles, and providing on-the-ground operational guidance that protects capital and accelerates commercial expansion.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Floating Side Dot Navigation -->
    <nav class="local-nav" aria-label="Page Sections Navigation">
      <ul class="local-nav-list">
        <li data-target="pillars">
          <a href="#pillars" class="local-nav-link" aria-label="Jump to Core Pillars">
            <span class="nav-dot"></span>
            <span class="nav-tooltip">Core Pillars</span>
          </a>
        </li>
        <li data-target="verticals">
          <a href="#verticals" class="local-nav-link" aria-label="Jump to Allocation Verticals">
            <span class="nav-dot"></span>
            <span class="nav-tooltip">Allocation Verticals</span>
          </a>
        </li>
        <li data-target="execution">
          <a href="#execution" class="local-nav-link" aria-label="Jump to Diligence Lifecycle">
            <span class="nav-dot"></span>
            <span class="nav-tooltip">Execution Lifecycle</span>
          </a>
        </li>
        <li data-target="contact">
          <a href="#contact" class="local-nav-link" aria-label="Jump to Contact KoreaIN">
            <span class="nav-dot"></span>
            <span class="nav-tooltip">Start Conversation</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Sub-Section 01: Core Investment Pillars (Photographic Banner + Open Editorial Layout) -->
    <section
      id="pillars"
      class="sub-section sub-section-banner"
      data-section-id="pillars"
      aria-labelledby="pillars-title"
    >
      <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/invest-1-1600.webp');">
        <div class="sub-section-header__overlay"></div>
        <div class="sub-section-deco" aria-hidden="true"></div>

        <div class="sub-section-title-wrap">
          <span class="sub-section-meta">
            <span class="sub-section-number">01</span>
            <span class="sub-section-category">Institutional Strategy</span>
          </span>
          <h2 id="pillars-title" class="sub-section-h">
            Core Investment<br />Pillars
          </h2>
        </div>
      </div>

      <div class="sub-section-surface">
        <!-- Discreet Cloud Trademark Watermark -->
        <div class="cloud-trademark-decor" aria-hidden="true">
          <svg viewBox="0 0 500 280" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M120 210c-38 0-70-26-70-60 0-31 25-57 58-60 6-40 45-72 92-72 25 0 48 9 64 24 17-35 55-58 100-58 58 0 106 41 110 94 25 4 44 25 44 50 0 29-25 52-56 52H120z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M180 210c0-26 22-48 50-48 18 0 34 9 43 24 11-21 34-36 60-36 36 0 64 26 68 60" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M85 160c-18 0-33-13-33-30 0-16 13-28 30-30 3-20 23-36 46-36 12 0 24 4 32 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M220 85c22-30 60-38 90-22s38 52 22 75-52 38-75 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="270" cy="115" r="4" fill="currentColor"/>
          </svg>
        </div>

        <div class="container">
          <div class="surface-intro">
            <span class="surface-badge">Bilateral Mandate</span>
            <p class="lead-statement">
              Tailored financial advisory, proprietary co-investment syndication, and sovereign-grade structuring built for institutional allocators, venture funds, and corporate venture arms.
            </p>
            <p class="body-text">
              KoreaIN bridges tier-1 Korean deep-tech innovation directly with cross-border capital, eliminating execution risk through local presence in Seoul and Riyadh.
            </p>
          </div>

          <!-- Pure Amorepacific Editorial Grid (Zero Boxed Cards) -->
          <div class="pillars-editorial-grid">
            <article class="pillar-editorial-item">
              <div class="editorial-meta">
                <span class="editorial-idx">01</span>
                <span class="editorial-tag">Venture Capital</span>
              </div>
              <h3 class="editorial-title">Cross-Border Venture Co-Investment</h3>
              <p class="editorial-desc">
                Direct access and syndicate participation in Korea's most promising Series A through Pre-IPO technology companies across AI, robotics, biotechnology, and mobility.
              </p>
              <ul class="editorial-list">
                <li>Proprietary deal flow screening &amp; founder diligence</li>
                <li>Bilateral LP/GP co-investment vehicles</li>
                <li>Technology transfer &amp; localization feasibility</li>
              </ul>
            </article>

            <article class="pillar-editorial-item">
              <div class="editorial-meta">
                <span class="editorial-idx">02</span>
                <span class="editorial-tag">Sovereign Advisory</span>
              </div>
              <h3 class="editorial-title">Sovereign &amp; Institutional Advisory</h3>
              <p class="editorial-desc">
                Strategic counsel for sovereign wealth entities, state-backed funds, and regional family offices establishing direct exposure to Korean industrial leadership.
              </p>
              <ul class="editorial-list">
                <li>Vision 2030 priority &amp; industrial alignment</li>
                <li>Industrial joint venture (JV) origination</li>
                <li>Sovereign portfolio diversification &amp; FDI liaison</li>
              </ul>
            </article>

            <article class="pillar-editorial-item">
              <div class="editorial-meta">
                <span class="editorial-idx">03</span>
                <span class="editorial-tag">Corporate M&amp;A</span>
              </div>
              <h3 class="editorial-title">M&amp;A &amp; Strategic Buyouts</h3>
              <p class="editorial-desc">
                Executing discreet, high-value mergers, majority acquisitions, and corporate carve-outs between Korean enterprises and international strategic buyers.
              </p>
              <ul class="editorial-list">
                <li>Target commercial, legal &amp; technical diligence</li>
                <li>Cultural negotiation &amp; valuation modeling</li>
                <li>Post-transaction integration &amp; governance roadmap</li>
              </ul>
            </article>

            <article class="pillar-editorial-item">
              <div class="editorial-meta">
                <span class="editorial-idx">04</span>
                <span class="editorial-tag">Fund Structuring</span>
              </div>
              <h3 class="editorial-title">Fund Structuring &amp; Regulatory Alignment</h3>
              <p class="editorial-desc">
                Navigating the intricacies of cross-border financial regulations, Foreign Direct Investment (FDI) guidelines in Korea, and capital repatriation protocols.
              </p>
              <ul class="editorial-list">
                <li>Cross-border tax &amp; compliance advisory</li>
                <li>SPV and fund domicile optimization</li>
                <li>Korean government liaison &amp; capital repatriation</li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Section 02: High-Growth Allocation Verticals (Photographic Banner + Asymmetric Split Editorial) -->
    <section
      id="verticals"
      class="sub-section sub-section-banner"
      data-section-id="verticals"
      aria-labelledby="verticals-title"
    >
      <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/invest-2-1600.webp');">
        <div class="sub-section-header__overlay"></div>
        <div class="sub-section-deco" aria-hidden="true"></div>

        <div class="sub-section-title-wrap">
          <span class="sub-section-meta">
            <span class="sub-section-number">02</span>
            <span class="sub-section-category">Sector Focus</span>
          </span>
          <h2 id="verticals-title" class="sub-section-h">
            High-Growth<br />Strategic Verticals
          </h2>
        </div>
      </div>

      <div class="sub-section-surface">
        <!-- Discreet Cloud Trademark Watermark -->
        <div class="cloud-trademark-decor cloud-trademark-decor--left" aria-hidden="true">
          <svg viewBox="0 0 500 280" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M120 210c-38 0-70-26-70-60 0-31 25-57 58-60 6-40 45-72 92-72 25 0 48 9 64 24 17-35 55-58 100-58 58 0 106 41 110 94 25 4 44 25 44 50 0 29-25 52-56 52H120z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M180 210c0-26 22-48 50-48 18 0 34 9 43 24 11-21 34-36 60-36 36 0 64 26 68 60" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M85 160c-18 0-33-13-33-30 0-16 13-28 30-30 3-20 23-36 46-36 12 0 24 4 32 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M220 85c22-30 60-38 90-22s38 52 22 75-52 38-75 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="270" cy="115" r="4" fill="currentColor"/>
          </svg>
        </div>

        <div class="container">
          <!-- Asymmetric Amorepacific Split Editorial (Zero Boxed Cards) -->
          <div class="verticals-editorial-split">
            <div class="verticals-lead-col">
              <span class="surface-badge">Competitive Advantage</span>
              <h3 class="verticals-lead-title">Targeting Sectors with Korea's Definite Global Leadership</h3>
              <p class="body-text">
                We concentrate capital where Korean engineering holds deep defensibility—patented intellectual property, scaled manufacturing ecosystems, and high-barrier industrial technologies aligned with international diversification mandates.
              </p>
            </div>

            <div class="verticals-matrix">
              <div class="vertical-matrix-row">
                <span class="matrix-idx">01</span>
                <div class="matrix-content">
                  <h4>Artificial Intelligence &amp; Semiconductors</h4>
                  <p>Generative AI enterprise infrastructure, neural processing unit (NPU) hardware, cognitive robotics, and specialized cleanroom fab equipment powering compute scalability.</p>
                  <div class="matrix-tags">
                    <span>High-Bandwidth Memory (HBM)</span>
                    <span>Edge AI Systems</span>
                    <span>Neural Processors</span>
                    <span>Smart Fab Automation</span>
                  </div>
                </div>
              </div>

              <div class="vertical-matrix-row">
                <span class="matrix-idx">02</span>
                <div class="matrix-content">
                  <h4>Electric Mobility &amp; Energy Storage</h4>
                  <p>Next-generation battery chemistry, EV component ecosystems, power electronics, and charging networks accelerating national fleet electrification and grid-scale storage.</p>
                  <div class="matrix-tags">
                    <span>Solid-State Chemistry</span>
                    <span>EV Powertrains</span>
                    <span>Battery Recycling</span>
                    <span>Thermal Management</span>
                  </div>
                </div>
              </div>

              <div class="vertical-matrix-row">
                <span class="matrix-idx">03</span>
                <div class="matrix-content">
                  <h4>Advanced Bio-Cosmetics &amp; Health</h4>
                  <p>High-efficacy skincare formulas, clinical peptide technology, medical aesthetics, and regenerative devices backed by Korea's world-leading bio-dermatology research institutes.</p>
                  <div class="matrix-tags">
                    <span>Clinical Peptides</span>
                    <span>Medical Aesthetics</span>
                    <span>Fermentation IP</span>
                    <span>Transdermal Delivery</span>
                  </div>
                </div>
              </div>

              <div class="vertical-matrix-row">
                <span class="matrix-idx">04</span>
                <div class="matrix-content">
                  <h4>Smart Infrastructure &amp; Green Tech</h4>
                  <p>Industrial hydrogen distribution systems, digital twin urban modeling, smart city sensory grids, and modular construction engineering designed for monumental international infrastructure.</p>
                  <div class="matrix-tags">
                    <span>Green Hydrogen</span>
                    <span>Digital Twin Urbanism</span>
                    <span>Modular Engineering</span>
                    <span>Smart Water Grids</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Section 03: Deal Execution & Diligence Lifecycle (Photographic Banner + Open Horizontal Track) -->
    <section
      id="execution"
      class="sub-section sub-section-banner"
      data-section-id="execution"
      aria-labelledby="execution-title"
    >
      <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/invest-3-1600.webp');">
        <div class="sub-section-header__overlay"></div>
        <div class="sub-section-deco" aria-hidden="true"></div>

        <div class="sub-section-title-wrap">
          <span class="sub-section-meta">
            <span class="sub-section-number">03</span>
            <span class="sub-section-category">Allocation Process</span>
          </span>
          <h2 id="execution-title" class="sub-section-h">
            Disciplined Execution<br />&amp; Diligence Lifecycle
          </h2>
        </div>
      </div>

      <div class="sub-section-surface">
        <!-- Discreet Cloud Trademark Watermark -->
        <div class="cloud-trademark-decor" aria-hidden="true">
          <svg viewBox="0 0 500 280" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M120 210c-38 0-70-26-70-60 0-31 25-57 58-60 6-40 45-72 92-72 25 0 48 9 64 24 17-35 55-58 100-58 58 0 106 41 110 94 25 4 44 25 44 50 0 29-25 52-56 52H120z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M180 210c0-26 22-48 50-48 18 0 34 9 43 24 11-21 34-36 60-36 36 0 64 26 68 60" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M85 160c-18 0-33-13-33-30 0-16 13-28 30-30 3-20 23-36 46-36 12 0 24 4 32 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M220 85c22-30 60-38 90-22s38 52 22 75-52 38-75 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="270" cy="115" r="4" fill="currentColor"/>
          </svg>
        </div>

        <div class="container">
          <div class="surface-intro">
            <span class="surface-badge">Institutional Governance</span>
            <p class="lead-statement">
              A structured 4-stage allocation lifecycle ensuring diligence rigor, governance transparency, and commercial acceleration.
            </p>
          </div>

          <!-- Open Amorepacific Horizontal Pathway (Zero Boxed Cards) -->
          <div class="lifecycle-flow-row">
            <article class="lifecycle-step">
              <span class="lifecycle-step__index">01</span>
              <h3 class="lifecycle-step__title">Proprietary Origination</h3>
              <p class="lifecycle-step__desc">
                Direct deal origination through vetted Korean tech ecosystems, premier R&amp;D clusters, and corporate spin-offs. Zero intermediary distortion.
              </p>
            </article>

            <article class="lifecycle-step">
              <span class="lifecycle-step__index">02</span>
              <h3 class="lifecycle-step__title">Rigorous Due Diligence</h3>
              <p class="lifecycle-step__desc">
                Technical stress-testing, laboratory &amp; cleanroom verification, forensic cap table auditing, and regulatory compliance under Korean and international law.
              </p>
            </article>

            <article class="lifecycle-step">
              <span class="lifecycle-step__index">03</span>
              <h3 class="lifecycle-step__title">Bilateral SPV Structuring</h3>
              <p class="lifecycle-step__desc">
                Tailored co-investment SPVs, cross-border tax treaty leverage, currency risk management, and formal Korean FDI incentive clearance.
              </p>
            </article>

            <article class="lifecycle-step">
              <span class="lifecycle-step__index">04</span>
              <h3 class="lifecycle-step__title">Post-Allocation Expansion</h3>
              <p class="lifecycle-step__desc">
                Active commercial acceleration: establishing regional joint ventures in Saudi Arabia &amp; the GCC, securing enterprise off-take, and scaling operations.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Section 04: Start a Conversation (Closing Section Matching Consultation Style) -->
    <section id="contact" class="closing-cta" aria-labelledby="cta-heading">
      <!-- Discreet Cloud Trademark Watermark -->
      <div class="cloud-trademark-decor cloud-trademark-decor--center" aria-hidden="true">
        <svg viewBox="0 0 500 280" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M120 210c-38 0-70-26-70-60 0-31 25-57 58-60 6-40 45-72 92-72 25 0 48 9 64 24 17-35 55-58 100-58 58 0 106 41 110 94 25 4 44 25 44 50 0 29-25 52-56 52H120z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M180 210c0-26 22-48 50-48 18 0 34 9 43 24 11-21 34-36 60-36 36 0 64 26 68 60" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M85 160c-18 0-33-13-33-30 0-16 13-28 30-30 3-20 23-36 46-36 12 0 24 4 32 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M220 85c22-30 60-38 90-22s38 52 22 75-52 38-75 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="270" cy="115" r="4" fill="currentColor"/>
        </svg>
      </div>

      <div class="container">
        <!-- Single Iconic Amorepacific Closing Card (Matching Consultation Page) -->
        <div class="closing-card">
          <div class="closing-card__visual">
            <img
              src="/home/business-areas/invest-4-1600.webp"
              alt="KoreaIN Global Investment Advisory"
              loading="lazy"
              decoding="async"
              class="closing-visual-img"
            />
          </div>

          <div class="closing-card__content">
            <span class="section-tag">Next Step</span>
            <h2 id="cta-heading" class="closing-card__title">Start a Conversation</h2>
            <p class="closing-card__subtitle">Deploy Capital with Strategic Clarity</p>
            <p class="closing-card__desc">
              Whether you are an institutional allocator seeking exposure to Korea's most innovative technology companies or an enterprise scaling cross-border joint ventures, KoreaIN provides the strategic bridge between capital and execution.
            </p>

            <div class="closing-card__action">
              <a href="/contact" class="closing-cta__btn">
                <span>Discuss Investment Opportunities</span>
                <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10h11M11 5l5 5-5 5" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = Array.from(document.querySelectorAll('.sub-section, #contact'));
    const navItems = Array.from(document.querySelectorAll('.local-nav-list li'));

    // IntersectionObserver for Amorepacific Sub-section Choreography
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            const targetId = entry.target.id;
            navItems.forEach((li) => {
              if (li.getAttribute('data-target') === targetId) {
                li.classList.add('is-current');
              } else {
                li.classList.remove('is-current');
              }
            });
          }
        });
      },
      {
        root: null,
        rootMargin: '-15% 0px -25% 0px',
        threshold: [0.1, 0.3]
      }
    );

    sections.forEach((sec) => sectionObserver.observe(sec));

    // Smooth Anchor Scrolling
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
