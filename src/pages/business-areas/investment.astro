---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Investment & Venture Advisory | KoreaIN"
  description="Connecting international capital, sovereign wealth funds, and venture investors with Korea's most innovative companies and strategic cross-border opportunities."
>
  <main id="main-content" class="page-investment">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li><a href="/business-areas">Business Areas</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Investment</li>
          </ol>
        </nav>

        <div class="page-hero__grid">
          <div class="page-hero__text">
            <h1 class="page-title">Global Investment &amp; Venture Advisory</h1>
            <p class="page-lead">
              KoreaIN mobilizes cross-border capital, sovereign wealth funds, and private equity to back high-impact Korean technological breakthroughs and strategic bilateral joint ventures between Korea, Saudi Arabia, the GCC, and international markets.
            </p>
            <div class="hero-actions">
              <a href="/contact" class="button button--primary">
                <span>Discuss Investment Opportunities</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 10h11M11 5l5 5-5 5" />
                </svg>
              </a>
              <a href="/business-areas" class="button button--secondary">
                <span>All Business Areas</span>
              </a>
            </div>
          </div>

          <div class="page-hero__stats">
            <div class="stat-card">
              <span class="stat-card__number">Bilateral</span>
              <span class="stat-card__label">Korea - GCC &amp; Global Capital Flow</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Tier-1</span>
              <span class="stat-card__label">Access to Korean Tech Ecosystem</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Vision 2030</span>
              <span class="stat-card__label">Aligned Strategic Synergies</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">End-to-End</span>
              <span class="stat-card__label">Due Diligence &amp; JV Structuring</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Visual Showcase: Black Rectangle Placeholder -->
    <section class="section visual-section">
      <div class="container">
        <div class="black-placeholder black-placeholder--hero" aria-label="Investment visual stage placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">Bilateral Investment &amp; Financial District Photography — Pending Final Selection</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategic Narrative -->
    <section class="section strategic-overview">
      <div class="container">
        <div class="split-overview">
          <div class="split-overview__lead">
            <h2 class="section-title">Catalyzing Bilateral Capital Allocation</h2>
          </div>
          <div class="split-overview__body">
            <p class="section-copy">
              South Korea has emerged as one of the world's most concentrated hubs for deep-tech patents, advanced hardware, semiconductor manufacturing, and consumer product breakthroughs. Concurrently, sovereign wealth funds, family offices, and institutional allocators across the Middle East and worldwide are actively seeking sustainable technology transfer, localized industrialization, and venture-grade returns.
            </p>
            <p class="section-copy">
              KoreaIN bridges this critical divide. Moving beyond traditional brokerage, we operate as an institutional catalyst—identifying vetted investment targets, structuring co-investment vehicles, and providing on-the-ground operational guidance that protects capital and accelerates commercial expansion.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Pillars -->
    <section class="section pillars-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Core Investment Pillars</h2>
          <p class="section-copy">
            Tailored financial advisory and cross-border structuring built for institutional allocators and corporate venture arms.
          </p>
        </header>

        <div class="pillars-grid">
          <article class="pillar-card">
            <div class="pillar-card__index">01</div>
            <h3 class="pillar-card__title">Cross-Border Venture Co-Investment</h3>
            <p class="pillar-card__copy">
              Direct access and syndicate participation in Korea's most promising Series A through Pre-IPO technology companies across AI, robotics, biotechnology, and mobility.
            </p>
            <ul class="pillar-card__list">
              <li>Proprietary deal flow screening</li>
              <li>Bilateral LP/GP co-investment vehicles</li>
              <li>Technology transfer feasibility</li>
            </ul>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__index">02</div>
            <h3 class="pillar-card__title">Sovereign &amp; Institutional Advisory</h3>
            <p class="pillar-card__copy">
              Strategic counsel for sovereign wealth entities, state-backed funds, and regional family offices establishing direct exposure to Korean industrial leadership.
            </p>
            <ul class="pillar-card__list">
              <li>Vision 2030 priority alignment</li>
              <li>Industrial joint venture origination</li>
              <li>Sovereign portfolio diversification</li>
            </ul>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__index">03</div>
            <h3 class="pillar-card__title">M&amp;A &amp; Strategic Buyouts</h3>
            <p class="pillar-card__copy">
              Executing discreet, high-value mergers, majority acquisitions, and corporate carve-outs between Korean enterprises and international strategic buyers.
            </p>
            <ul class="pillar-card__list">
              <li>Target commercial diligence</li>
              <li>Cultural &amp; regulatory negotiation</li>
              <li>Post-transaction integration roadmap</li>
            </ul>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__index">04</div>
            <h3 class="pillar-card__title">Fund Structuring &amp; Regulatory Alignment</h3>
            <p class="pillar-card__copy">
              Navigating the intricacies of cross-border financial regulations, foreign direct investment (FDI) guidelines in Korea, and capital repatriation protocols.
            </p>
            <ul class="pillar-card__list">
              <li>Cross-border tax &amp; compliance advisory</li>
              <li>SPV and fund domicile optimization</li>
              <li>Government liaison (FDI incentives)</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- Investment Verticals & Second Visual Placeholder -->
    <section class="section verticals-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">High-Growth Allocation Verticals</h2>
          <p class="section-copy">
            We focus capital deployment where Korea holds definitive global competitive advantages.
          </p>
        </header>

        <div class="verticals-grid">
          <div class="vertical-item">
            <span class="vertical-item__icon">✦</span>
            <h4>Artificial Intelligence &amp; Semiconductors</h4>
            <p>Generative AI enterprise infrastructure, NPU hardware, cognitive robotics, and smart fab equipment.</p>
          </div>
          <div class="vertical-item">
            <span class="vertical-item__icon">✦</span>
            <h4>Electric Mobility &amp; Energy Storage</h4>
            <p>Next-generation battery chemistry, EV component ecosystems, power electronics, and charging networks.</p>
          </div>
          <div class="vertical-item">
            <span class="vertical-item__icon">✦</span>
            <h4>Advanced Bio-Cosmetics &amp; Health</h4>
            <p>High-efficacy skincare formulas, clinical peptide technology, medical aesthetics, and regenerative devices.</p>
          </div>
          <div class="vertical-item">
            <span class="vertical-item__icon">✦</span>
            <h4>Smart Infrastructure &amp; Green Tech</h4>
            <p>Hydrogen distribution systems, digital twin urban modeling, and modular construction engineering.</p>
          </div>
        </div>

        <!-- Secondary Black Rectangle Placeholder -->
        <div class="black-placeholder black-placeholder--secondary" aria-label="Portfolio & data visualization placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">Capital Flow Diagram &amp; Investment Ecosystem Architecture — Pending Design</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Next Steps CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Connect with Our Investment Team</h2>
          <p class="cta-card__copy">
            Whether you are an institutional fund exploring Korean co-investments or a Korean scale-up seeking global expansion capital, KoreaIN provides the strategic bridge.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Initiate Investment Inquiry</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/about" class="button button--secondary">
              <span>About KoreaIN Leadership</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-actions svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .page-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 8rem;
  }

  .stat-card__number {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .stat-card__label {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* Black Placeholder Box */
  .visual-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .black-placeholder {
    width: 100%;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }

  .black-placeholder--hero {
    aspect-ratio: 21 / 9;
    min-height: 20rem;
  }

  .black-placeholder--secondary {
    aspect-ratio: 16 / 8;
    min-height: 16rem;
    margin-top: 3.5rem;
  }

  .black-placeholder__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
    position: relative;
    z-index: 2;
  }

  .black-placeholder__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .black-placeholder__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .black-placeholder__note {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 28rem;
  }

  /* Split Overview */
  .strategic-overview {
    background: var(--color-surface);
  }

  .split-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .split-overview__lead .section-title {
    margin-top: 0.5rem;
  }

  .split-overview__body p + p {
    margin-top: 1.5rem;
  }

  /* Pillars Section */
  .section-header {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .pillar-card {
    padding: clamp(2rem, 3.5vw, 2.75rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-secondary) 40%, var(--color-border));
  }

  .pillar-card__index {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 1.25rem;
  }

  .pillar-card__title {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .pillar-card__copy {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .pillar-card__list {
    padding-left: 1.2rem;
    margin: 0;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* Verticals Section */
  .verticals-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .vertical-item {
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .vertical-item__icon {
    display: inline-block;
    color: var(--color-accent);
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .vertical-item h4 {
    font-size: 1.1rem;
    font-weight: 650;
    color: var(--color-text);
    margin-bottom: 0.65rem;
    letter-spacing: -0.015em;
  }

  .vertical-item p {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }


  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .page-hero__grid {
      grid-template-columns: 1fr;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .verticals-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .split-overview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .verticals-grid {
      grid-template-columns: 1fr;
    }

    .page-hero__stats {
      grid-template-columns: 1fr;
    }
  }
</style>