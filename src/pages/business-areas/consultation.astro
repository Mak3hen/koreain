<script is:inline>
  // ============================================================================
  // Amorepacific Animation & Scroll Engine for Consultation Portal
  // ============================================================================
  document.addEventListener('DOMContentLoaded', () => {
    const cover = document.getElementById('cover');
    const coverBg = document.getElementById('coverBg');
    const coverContent = document.getElementById('coverContent');
    const coverMouse = document.getElementById('coverMouse');
    const sections = Array.from(document.querySelectorAll('.sub-section, #cover, #contact'));
    const navItems = Array.from(document.querySelectorAll('.local-nav-list li'));

    // 1. Cover background smooth entrance & subtle mouse parallax
    if (cover && coverBg) {
      coverBg.classList.add('is-loaded');

      if (window.matchMedia('(min-width: 1024px)').matches) {
        cover.addEventListener('mousemove', (e) => {
          const rect = cover.getBoundingClientRect();
          const x = (e.clientX - rect.width / 2) / (rect.width / 2);
          const y = (e.clientY - rect.height / 2) / (rect.height / 2);
          coverBg.style.transform = `scale(1.05) translate(${x * -18}px, ${y * -12}px)`;
        });

        cover.addEventListener('mouseleave', () => {
          coverBg.style.transform = 'scale(1) translate(0, 0)';
        });
      }
    }

    // 2. Cover scroll fade-out
    const handleScrollFade = () => {
      const scrollY = window.scrollY;
      const fadeThreshold = window.innerHeight * 0.5;

      if (coverContent) {
        const opacity = Math.max(0, 1 - scrollY / fadeThreshold);
        const translateY = scrollY * 0.3;
        coverContent.style.opacity = opacity.toFixed(2);
        coverContent.style.transform = `translateY(${translateY.toFixed(1)}px)`;
      }

      if (coverMouse) {
        coverMouse.style.opacity = Math.max(0, 1 - scrollY / (fadeThreshold * 0.5)).toFixed(2);
      }
    };

    window.addEventListener('scroll', handleScrollFade, { passive: true });

    // 3. Section reveal & choreography observer
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            const id = entry.target.id;
            navItems.forEach((li) => {
              if (li.getAttribute('data-target') === id) {
                li.classList.add('is-current');
              } else {
                li.classList.remove('is-current');
              }
            });
          }
        });
      },
      {
        root: null,
        rootMargin: '-20% 0px -30% 0px',
        threshold: [0.1, 0.3]
      }
    );

    sections.forEach((sec) => sectionObserver.observe(sec));

    // 4. Smooth Anchor Scrolling
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

