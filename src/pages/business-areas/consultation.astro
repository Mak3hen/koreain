---
import BaseLayout from '../../layouts/BaseLayout.astro';

const navItems = [
  { id: 'cover', label: 'Overview' },
  { id: 'philosophy', label: '01 Perspective' },
  { id: 'market-entry', label: '02 Market Entry' },
  { id: 'business-dev', label: '03 Business Dev & Alliances' },
  { id: 'bilateral-corridors', label: '04 Bilateral Corridors' },
  { id: 'advisory', label: '05 Advisory & Facilitation' },
  { id: 'approach', label: '06 Our Approach' },
  { id: 'why-koreain', label: '07 Why KoreaIN & Ecosystem' },
  { id: 'contact', label: '08 Start a Conversation' }
];

const approachSteps = [
  {
    step: '01',
    title: 'Understand',
    desc: 'We begin by understanding the company, its objectives, capabilities, target market, and definition of success.'
  },
  {
    step: '02',
    title: 'Evaluate',
    desc: 'We assess the opportunity, local environment, potential stakeholders, and practical path forward.'
  },
  {
    step: '03',
    title: 'Connect',
    desc: 'We identify and engage relevant companies, organizations, partners, or decision-makers.'
  },
  {
    step: '04',
    title: 'Facilitate',
    desc: 'We support communication, meetings, relationship development, and cross-border coordination.'
  },
  {
    step: '05',
    title: 'Develop',
    desc: 'We help transform promising discussions into structured commercial opportunities and sustainable relationships.'
  }
];

const whyKoreaIN = [
  {
    title: 'Local Presence',
    desc: 'Direct understanding of the Korean business environment combined with active engagement across Saudi Arabia and international markets.'
  },
  {
    title: 'Cross-Cultural Understanding',
    desc: 'The ability to bridge different corporate cultures, communication styles, expectations, and ways of doing business.'
  },
  {
    title: 'Business Networks',
    desc: 'Access to relationships across companies, institutions, manufacturers, investors, and strategic partners.'
  },
  {
    title: 'Execution Focus',
    desc: 'We focus on helping clients move from research and discussion toward tangible business activity.'
  },
  {
    title: 'Long-Term Perspective',
    desc: 'Our objective is not simply to create introductions, but to support relationships capable of generating lasting commercial value.'
  }
];

const targetClients = [
  'Korean companies expanding internationally',
  'Saudi and Middle Eastern organizations seeking Korean partners',
  'International companies entering South Korea',
  'Manufacturers and technology providers',
  'Investors and investment groups',
  'Distributors and commercial partners',
  'Institutions and business organizations',
  'Companies exploring joint ventures or strategic cooperation'
];
---

<BaseLayout
  title="Consultation & Strategic Advisory | KoreaIN"
  description="Strategic guidance for cross-border growth between South Korea, Saudi Arabia, and international markets. Connecting strategy with execution through local insight and trusted networks."
>
  <main id="main-content" class="consultation-portal">
    <!-- Floating Side Dot Navigation (Amorepacific .local-nav) -->
    <nav class="local-nav" aria-label="Consultation page navigation">
      <ul class="local-nav-list">
        {navItems.map((item, index) => (
          <li class={index === 0 ? 'is-current' : ''} data-target={item.id}>
            <a href={`#${item.id}`} class="local-nav-link" aria-label={item.label}>
              <span class="nav-tooltip">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 1. Hero Cover (Full Viewport Cover with Parallax & Fade-Out) -->
    <header id="cover" class="cover" aria-labelledby="cover-title">
      <div class="cover-spacer">
        <div
          class="cover-bg"
          id="coverBg"
          style="background-image: url('/home/business-areas/consulting_hero-1600.webp');"
        ></div>
        <div class="cover-overlay"></div>
      </div>

      <div class="container cover-content" id="coverContent">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/business-areas">Business Areas</a></li>
            <li aria-current="page">Consultation</li>
          </ol>
        </nav>

        <h1 id="cover-title" class="cover-h">Consultation</h1>
        <p class="cover-subtitle">Strategic Guidance for Cross-Border Growth</p>

        <div class="cover-desc-group">
          <p class="cover-lead">
            KoreaIN helps companies navigate the commercial, cultural, and operational realities of doing business between South Korea, Saudi Arabia, and international markets.
          </p>
          <p class="cover-copy">
            We work alongside organizations seeking to enter new markets, identify reliable partners, structure strategic relationships, and transform opportunities into practical business outcomes.
          </p>
          <p class="cover-copy">
            Our role is not limited to advisory. We connect strategy with execution through local insight, trusted networks, and direct market engagement.
          </p>
        </div>

        <div class="cover-action">
          <a href="/contact" class="btn-cover">
            <span>Discuss Your Project</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 10h11M11 5l5 5-5 5" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Animated Mouse Scroll Indicator -->
      <a href="#philosophy" class="cover-mouse" id="coverMouse" aria-label="Scroll to first section">
        <span class="mouse-icon"></span>
        <span class="mouse-text">Scroll</span>
      </a>
    </header>

    <!-- Main Showcase Sections (Amorepacific Sub-section Choreography) -->
    <div class="page-contents">

      <!-- SECTION 01: Core Perspective (Tall Visual Banner + Architectural Surface Body) -->
      <section
        id="philosophy"
        class="sub-section sub-section-banner"
        data-section-id="philosophy"
        aria-labelledby="philosophy-title"
      >
        <!-- High Cinematic Visual Banner -->
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/growth-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">01</span>
              <span class="sub-section-category">Core Perspective</span>
            </span>
            <h2 id="philosophy-title" class="sub-section-h">
              Bridging Markets,<br />People and Opportunity
            </h2>
          </div>
        </div>

        <!-- Grand, Spacious Architectural Editorial Surface -->
        <div class="sub-section-surface philosophy-surface">
          <div class="container">
            <div class="philosophy-layout">
              <div class="philosophy-lead-box">
                <span class="practice-tag">Executive Premise</span>
                <h3 class="philosophy-headline">Understanding Decision-Making on the Ground</h3>
                <blockquote class="philosophy-quote">
                  "Successful international expansion requires more than market information. It requires an understanding of how decisions are made, how relationships are built, how opportunities are evaluated, and how business is conducted on the ground."
                </blockquote>
              </div>

              <div class="philosophy-body-grid">
                <div class="philosophy-col">
                  <h4 class="philosophy-col-title">Intersection of Capability &amp; Demand</h4>
                  <p class="body-text">
                    KoreaIN operates at the intersection of Korean capability and international demand, helping companies move confidently across different business environments.
                  </p>
                </div>
                <div class="philosophy-col">
                  <h4 class="philosophy-col-title">Long-Term Local Activity</h4>
                  <p class="body-text">
                    From early-stage market exploration to long-term commercial development, we provide the context, access, and coordination needed to turn international ambition into sustainable local activity.
                  </p>
                </div>
              </div>

              <div class="philosophy-action-row">
                <a href="#market-entry" class="sub-section-more">
                  <span>Explore Market Entry &amp; Expansion</span>
                  <svg class="more-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 10h11M11 5l5 5-5 5" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 02: Market Entry & Expansion (Tall Visual Banner + 4 Pillars) -->
      <section
        id="market-entry"
        class="sub-section sub-section-banner"
        data-section-id="market-entry"
        aria-labelledby="entry-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/building-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">02</span>
              <span class="sub-section-category">Market Entry &amp; Expansion</span>
            </span>
            <h2 id="entry-title" class="sub-section-h">
              Enter New Markets<br />with Clarity
            </h2>
          </div>
        </div>

        <!-- Structured Surface Body -->
        <div class="sub-section-surface">
          <div class="container">
            <div class="surface-intro">
              <p class="lead-statement">
                Entering a new country can involve unfamiliar commercial practices, regulatory environments, customer expectations, and partnership structures.
              </p>
              <p class="body-text">
                KoreaIN supports companies throughout the market-entry process by helping them understand the landscape before major decisions are made.
              </p>
            </div>

            <div class="pillars-block">
              <h3 class="pillars-subheading">Our support includes</h3>
              <div class="entry-pillars-grid">
                <article class="pillar-box">
                  <span class="pillar-idx">01</span>
                  <h4 class="pillar-title">Market Assessment</h4>
                  <p class="pillar-desc">
                    Evaluate market potential, competitive conditions, commercial opportunities, and key barriers before committing resources.
                  </p>
                </article>

                <article class="pillar-box">
                  <span class="pillar-idx">02</span>
                  <h4 class="pillar-title">Entry Strategy</h4>
                  <p class="pillar-desc">
                    Define the most appropriate approach based on business objectives, sector dynamics, available resources, and local conditions.
                  </p>
                </article>

                <article class="pillar-box">
                  <span class="pillar-idx">03</span>
                  <h4 class="pillar-title">Local Positioning</h4>
                  <p class="pillar-desc">
                    Adapt value propositions, commercial messaging, and business approaches to better reflect the expectations of the target market.
                  </p>
                </article>

                <article class="pillar-box">
                  <span class="pillar-idx">04</span>
                  <h4 class="pillar-title">Go-to-Market Coordination</h4>
                  <p class="pillar-desc">
                    Support the transition from planning to market activity through introductions, meetings, local coordination, and opportunity development.
                  </p>
                </article>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 03: Business Development & Strategic Partnerships (Streamlined & Effortless to Read) -->
      <section
        id="business-dev"
        class="sub-section sub-section-banner"
        data-section-id="business-dev"
        aria-labelledby="business-dev-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/business_consulting-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">03</span>
              <span class="sub-section-category">Commercial Execution</span>
            </span>
            <h2 id="business-dev-title" class="sub-section-h">
              Business Development &amp;<br />Strategic Partnerships
            </h2>
          </div>
        </div>

        <!-- Clean, Scannable Dual Surface Body -->
        <div class="sub-section-surface">
          <div class="container">
            <div class="dual-compact-grid">
              <!-- Card 1: Business Development -->
              <article class="practice-card">
                <div class="practice-card__header">
                  <span class="practice-tag">Practice 01</span>
                  <h3 class="practice-title">Business Development</h3>
                  <p class="practice-sub">From Opportunity to Commercial Relationship</p>
                  <p class="practice-lead">
                    International growth depends on identifying the right opportunities and engaging the right people. KoreaIN bridges communication gaps and supports business development initiatives between Korean organizations and international decision-makers.
                  </p>
                </div>

                <div class="practice-card__content">
                  <h4 class="practice-list-title">Business development support</h4>
                  <div class="practice-tags-grid">
                    <div class="tag-item"><span>Opportunity identification</span></div>
                    <div class="tag-item"><span>Strategic introductions</span></div>
                    <div class="tag-item"><span>Partner &amp; stakeholder mapping</span></div>
                    <div class="tag-item"><span>Meeting coordination</span></div>
                    <div class="tag-item"><span>Commercial follow-up</span></div>
                    <div class="tag-item"><span>Relationship development</span></div>
                    <div class="tag-item"><span>Market representation support</span></div>
                    <div class="tag-item"><span>Local engagement &amp; communication</span></div>
                  </div>
                </div>
              </article>

              <!-- Card 2: Strategic Partnerships -->
              <article class="practice-card">
                <div class="practice-card__header">
                  <span class="practice-tag">Practice 02</span>
                  <h3 class="practice-title">Strategic Partnerships</h3>
                  <p class="practice-sub">Building the Right Relationships</p>
                  <p class="practice-lead">
                    Strong partnerships accelerate market access, strengthen local credibility, and create long-term value. We focus on compatibility, alignment, and practical execution rather than introductions alone.
                  </p>
                </div>

                <div class="practice-card__content">
                  <h4 class="practice-list-title">Partnership support may include</h4>
                  <div class="partner-phases-stack">
                    <div class="phase-row">
                      <span class="phase-num">01</span>
                      <div class="phase-info">
                        <h5 class="phase-name">Partner Identification</h5>
                        <p class="phase-text">Identify organizations with relevant capabilities, market presence, networks, or strategic alignment.</p>
                      </div>
                    </div>
                    <div class="phase-row">
                      <span class="phase-num">02</span>
                      <div class="phase-info">
                        <h5 class="phase-name">Partner Evaluation</h5>
                        <p class="phase-text">Assess potential fit based on objectives, capabilities, positioning, and commercial potential.</p>
                      </div>
                    </div>
                    <div class="phase-row">
                      <span class="phase-num">03</span>
                      <div class="phase-info">
                        <h5 class="phase-name">Relationship Facilitation</h5>
                        <p class="phase-text">Create direct communication between stakeholders and support discussions across cultural boundaries.</p>
                      </div>
                    </div>
                    <div class="phase-row">
                      <span class="phase-num">04</span>
                      <div class="phase-info">
                        <h5 class="phase-name">Partnership Development</h5>
                        <p class="phase-text">Help move discussions from initial interest toward defined cooperation and commercial activity.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 04: Direct Bilateral Market Access (Text directly over the ship image) -->
      <section
        id="bilateral-corridors"
        class="sub-section sub-section-overlay-hero"
        data-section-id="bilateral-corridors"
        aria-labelledby="corridors-title"
      >
        <div class="bilateral-hero-bg" style="background-image: url('/home/business-areas/trading_logistics-1600.webp');">
          <div class="bilateral-hero-overlay"></div>

          <div class="container bilateral-hero-container">
            <!-- Header over ship visual -->
            <div class="bilateral-hero-intro">
              <span class="sub-section-meta">
                <span class="sub-section-number">04</span>
                <span class="sub-section-category">Bilateral Corridors</span>
              </span>
              <h2 id="corridors-title" class="bilateral-hero-h">
                Direct Bilateral Market Access
              </h2>
              <p class="bilateral-hero-lead">
                Connecting South Korea’s industrial superiority with Saudi Arabia’s national economic transformation.
              </p>
            </div>

            <!-- 2 Compact Overlaid Columns -->
            <div class="bilateral-overlay-grid">
              <!-- Column 1: South Korea Market Access -->
              <div class="bilateral-glass-col">
                <span class="bilateral-hub-badge">Seoul Hub</span>
                <h3 class="bilateral-hub-title">Korea Market Access</h3>
                <p class="bilateral-hub-sub">Navigate South Korea with Local Understanding</p>
                <p class="bilateral-hub-desc">
                  South Korea is one of the world's most advanced industrial, technology, and manufacturing economies. KoreaIN provides direct local presence and cultural familiarity to support international companies seeking Korean technologies, products, manufacturers, strategic partners, and investment opportunities.
                </p>
                <div class="bilateral-hub-list">
                  <span class="list-head">Korea-focused support:</span>
                  <div class="hub-tags-wrap">
                    <span class="hub-tag">Company sourcing</span>
                    <span class="hub-tag">Manufacturer &amp; supplier ID</span>
                    <span class="hub-tag">Technology scouting</span>
                    <span class="hub-tag">Partnership development</span>
                    <span class="hub-tag">Meeting coordination</span>
                    <span class="hub-tag">Commercial introductions</span>
                    <span class="hub-tag">Market intelligence</span>
                    <span class="hub-tag">Relationship management</span>
                  </div>
                </div>
              </div>

              <!-- Column 2: Saudi Arabia & Middle East -->
              <div class="bilateral-glass-col">
                <span class="bilateral-hub-badge">Riyadh Focus</span>
                <h3 class="bilateral-hub-title">Saudi Arabia &amp; Middle East</h3>
                <p class="bilateral-hub-sub">Connecting Korean Capability with Regional Ambition</p>
                <p class="bilateral-hub-desc">
                  Saudi Arabia and the wider Middle East are undergoing significant economic transformation, creating new opportunities across technology, infrastructure, mobility, consumer industries, investment, and advanced services. KoreaIN helps Korean companies understand these markets and build meaningful relationships with local organizations.
                </p>
                <div class="bilateral-hub-quote">
                  <p>"Our objective is to create practical connections between complementary capabilities on both sides of the relationship."</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 05: Cross-Border Advisory & Project Facilitation (Tall Banner) -->
      <section
        id="advisory"
        class="sub-section sub-section-banner"
        data-section-id="advisory"
        aria-labelledby="advisory-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/who-we-are/innovation-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">05</span>
              <span class="sub-section-category">Strategic Alignment</span>
            </span>
            <h2 id="advisory-title" class="sub-section-h">
              Cross-Border Advisory &amp;<br />Project Facilitation
            </h2>
          </div>
        </div>

        <!-- Advisory Surface Body -->
        <div class="sub-section-surface">
          <div class="container">
            <div class="advisory-block">
              <div class="advisory-header">
                <span class="practice-tag">Strategic Input</span>
                <h3 class="practice-title">Cross-Border Advisory</h3>
                <p class="practice-sub">Decisions Informed by Local Context</p>
                <div class="advisory-prose">
                  <p class="body-text">
                    International projects often involve decisions that cannot be made effectively from a distance. KoreaIN provides strategic input grounded in local market realities, stakeholder dynamics, and cross-cultural business experience. We help clients evaluate opportunities from both sides of the relationship before committing significant time or resources.
                  </p>
                </div>
              </div>

              <div class="advisory-areas">
                <h4 class="pillars-subheading">Areas of advisory</h4>
                <div class="advisory-grid">
                  <div class="advisory-item"><span>Market opportunity assessment</span></div>
                  <div class="advisory-item"><span>International expansion strategy</span></div>
                  <div class="advisory-item"><span>Partnership strategy</span></div>
                  <div class="advisory-item"><span>Commercial positioning</span></div>
                  <div class="advisory-item"><span>Market intelligence</span></div>
                  <div class="advisory-item"><span>Stakeholder strategy</span></div>
                  <div class="advisory-item"><span>Cross-cultural business guidance</span></div>
                  <div class="advisory-item"><span>Opportunity evaluation</span></div>
                  <div class="advisory-item"><span>Business development planning</span></div>
                </div>
              </div>
            </div>

            <!-- Project Facilitation Block -->
            <div class="facilitation-block">
              <div class="facilitation-grid">
                <div class="facilitation-left">
                  <span class="practice-tag">Operations</span>
                  <h3 class="practice-title">Project Facilitation</h3>
                  <p class="practice-sub">Keeping International Projects Moving</p>
                </div>
                <div class="facilitation-right">
                  <p class="body-text">
                    Cross-border projects can lose momentum when communication becomes fragmented across organizations, countries, and time zones. KoreaIN can act as a local coordination point between stakeholders, helping maintain communication and progress throughout the development of an opportunity.
                  </p>
                  <p class="body-text">
                    Depending on the project, this may include arranging meetings, coordinating communications, clarifying expectations, following up with stakeholders, and helping both sides navigate local business practices.
                  </p>
                  <div class="facilitation-highlight">
                    <p>The objective is simple: reduce friction between opportunity and execution.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 06: Our Approach (Tall Banner + 5 Chronological Steps) -->
      <section
        id="approach"
        class="sub-section sub-section-banner"
        data-section-id="approach"
        aria-labelledby="approach-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/markets/global_1-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">06</span>
              <span class="sub-section-category">Methodology</span>
            </span>
            <h2 id="approach-title" class="sub-section-h">
              Our 5-Step<br />Approach
            </h2>
          </div>
        </div>

        <!-- Approach Track Surface Body -->
        <div class="sub-section-surface">
          <div class="container">
            <div class="surface-intro">
              <p class="lead-statement">
                A disciplined methodology turning international ambition into structured commercial reality.
              </p>
            </div>

            <div class="approach-track">
              {approachSteps.map((item) => (
                <article class="approach-step">
                  <span class="approach-step__number">{item.step}</span>
                  <h3 class="approach-step__title">{item.title}</h3>
                  <p class="approach-step__desc">{item.desc}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 07: Why KoreaIN & Client Ecosystem (Architectural 5-Column Grid & Balanced Split) -->
      <section
        id="why-koreain"
        class="sub-section sub-section-banner"
        data-section-id="why-koreain"
        aria-labelledby="why-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/who-we-are/lotte_tower-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">07</span>
              <span class="sub-section-category">Strategic Advantage</span>
            </span>
            <h2 id="why-title" class="sub-section-h">
              Why KoreaIN &amp;<br />Client Ecosystem
            </h2>
          </div>
        </div>

        <!-- Value Pillars & Client Ecosystem Surface Body -->
        <div class="sub-section-surface">
          <div class="container">
            <!-- 5 Architectural Value Pillars in 1 Sleek Row -->
            <div class="why-intro-block">
              <span class="practice-tag">Core Value Drivers</span>
              <h3 class="practice-title">Why KoreaIN</h3>
              <p class="body-text">
                Founded on two decades of bilateral trust, direct C-suite engagement, and on-the-ground operational capability.
              </p>
            </div>

            <div class="why-pillars-row">
              {whyKoreaIN.map((item, index) => (
                <div class="why-pillar-col">
                  <span class="why-pillar-idx">0{index + 1}</span>
                  <h4 class="why-pillar-title">{item.title}</h4>
                  <p class="why-pillar-desc">{item.desc}</p>
                </div>
              ))}
            </div>

            <!-- Balanced 2-Column Split: Ecosystem & Execution Continuum -->
            <div class="ecosystem-split-grid">
              <!-- Left: Who We Work With -->
              <div class="ecosystem-col">
                <span class="practice-tag">Client Reach</span>
                <h4 class="split-col-title">Who We Work With</h4>
                <p class="split-col-desc">
                  KoreaIN supports organizations at different stages of international growth:
                </p>

                <div class="clients-cards-grid">
                  {targetClients.map((client) => (
                    <div class="client-card">
                      <span class="client-card-dot"></span>
                      <span>{client}</span>
                    </div>
                  ))}
                </div>
