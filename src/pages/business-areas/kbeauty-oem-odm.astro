    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 9999px;
    transition: all 260ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
  }

  .btn-cover:hover {
    background: #eef2ff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .btn-cover--secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: none;
  }

  .btn-cover--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #ffffff;
    color: #ffffff;
  }

  .cta-arrow {
    width: 18px;
    height: 18px;
    transition: transform 240ms ease;
  }

  .btn-cover:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* Animated Scroll Down Indicator */
  .cover-mouse {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: opacity 300ms ease;
  }

  .cover-mouse:hover {
    color: #ffffff;
  }

  .mouse-icon {
    width: 20px;
    height: 32px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    position: relative;
  }

  .mouse-icon::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    height: 6px;
    background: #ffffff;
    border-radius: 2px;
    animation: mouseWheel 1.8s ease-in-out infinite;
  }

  @keyframes mouseWheel {
    0% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    50% {
      opacity: 0.2;
      transform: translate(-50%, 10px);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  /* --------------------------------------------------------------------------
     3. High Cinematic Visual Banners (.sub-section-header--tall)
     -------------------------------------------------------------------------- */
  .sub-section-banner {
    position: relative;
    padding-top: 0;
  }

  .sub-section-header--tall {
    position: relative;
    width: 100%;
    height: clamp(540px, 68vh, 760px);
    min-height: 520px;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-inline: clamp(1.5rem, 6vw, 6rem);
    overflow: hidden;
  }

  .sub-section-header__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(7, 11, 38, 0.58) 0%,
      rgba(7, 11, 38, 0.45) 50%,
      rgba(7, 11, 38, 0.78) 100%
