---
import BaseLayout from '../../layouts/BaseLayout.astro';

const navItems = [
  { id: 'cover', label: 'Overview' },
  { id: 'vision-mission', label: '01 Vision & Mission' },
  { id: 'competencies', label: '02 Core Competencies' },
  { id: 'categories', label: '03 Product Portfolio' },
  { id: 'formulation', label: '04 Formulation Science' },
  { id: 'process', label: '05 6-Step Development' },
  { id: 'why-koreain', label: '06 Why KoreaIN' },
  { id: 'global-reach', label: '07 Global Adaptation' },
  { id: 'certifications', label: '08 Certifications & QC' },
  { id: 'ceo-message', label: '09 Leadership' },
  { id: 'contact', label: '10 Start Your Line' }
];

const competencies = [
  {
    idx: '01',
    title: 'Advanced R&D & Formulation',
    lead: 'Pioneering cleanroom cosmetic chemistry, bio-active stabilization, and targeted delivery systems.',
    points: [
      'Anhydrous and waterless concentrated skincare formulations',
      'Proprietary biomimetic emulsions and micro-droplet delivery',
      'Stabilization of sensitive actives (Vitamin C, Retinol, Peptides)',
      'Micro-encapsulated delivery systems for targeted active release',
      'Accelerated thermal stability and preservative challenge testing'
    ]
  },
  {
    idx: '02',
    title: 'Natural & Functional Bio-Actives',
    lead: 'Ethically sourced botanical ingredients, clean bio-actives, and proven dermatological efficacy.',
    points: [
      'Korean Panax Ginseng with saponin bio-enrichment',
      'Jeju Island organic green tea water and antioxidant polyphenols',
      'Pearl extract for luminous skin radiance',
      'Centella Asiatica (Cica) for skin barrier repair',
      'Raw material safety documentation and efficacy reports'
    ]
  },
  {
    idx: '03',
    title: 'GMP-Certified Manufacturing',
    lead: 'Cleanroom manufacturing facilities operating to ISO 22716 Good Manufacturing Practice.',
    points: [
      'ISO 22716 certified cleanroom environments (Class 10k & 100k)',
      'Modern automated compounding and precision filling lines',
      'Batch traceability and raw material documentation',
      'Multi-stage quality control: heavy metals, microbiology & drop testing',
      'Compounding capacity scaling from pilot batches to high-volume production'
    ]
  },
  {
    idx: '04',
    title: 'Global Regulatory & Certifications',
    lead: 'Turnkey market authorization across North America, Europe, the Middle East, and Asia.',
    points: [
      'US FDA compliance, product listing, and MoCRA readiness',
      'European Union CPNP registration and safety reports',
      'Saudi SFDA and UAE ESMA cosmetic registration dossiers',
      'Certified Vegan verification (Eve Vegan & The Vegan Society)',
      'Recognized HALAL certification (alcohol-free & dedicated lines)'
    ]
  },
  {
    idx: '05',
    title: 'Full-Service Turnkey OEM/ODM',
    lead: 'End-to-end brand stewardship from white-paper concept to finished, palletized retail goods.',
    points: [
      'Packaging sourcing: airless bottles, glass droppers, luxury jars',
      'Sustainable materials: PCR plastics, refillable containers, FSC cartons',
      'Brand design alignment, typography, and luxury finishing',
      'Primary container compatibility and formula interaction testing',
      'Secondary box engineering and barcode verification'
    ]
  },
  {
    idx: '06',
    title: 'Reliable Global Logistics',
    lead: 'Cold-chain distribution ensuring formulation integrity from Seoul to global destinations.',
    points: [
      'Temperature-monitored warehousing and containerized transit',
      'Export customs handling and documentation clearance',
      'Air express sampling and sea freight container consolidation',
      'Established distribution corridors to Saudi Arabia, UAE, EU, and USA',
      'Post-delivery monitoring and reorder forecasting'
    ]
  }
];

const developmentSteps = [
  {
    step: '01',
    title: 'Consultation & Strategy',
    desc: 'We define your brand vision, target demographic, competitive benchmarks, formula specifications, packaging aesthetics, unit economics, and launch milestones.'
  },
  {
    step: '02',
    title: 'R&D & Sampling',
    desc: 'Our cosmetic chemists develop bespoke formulations. Initial bench samples are delivered within 2-3 weeks for sensory evaluation, scent tuning, and texture refinement.'
  },
  {
    step: '03',
    title: 'Packaging & Design',
    desc: 'Selection of primary containers (airless pumps, glass droppers, luxury treatment jars, PCR materials), luxury finishing, and drop-test compatibility verification.'
  },
  {
    step: '04',
    title: 'Regulatory & Certifications',
    desc: 'Compilation of the Product Information File (PIF), safety assessments, MSDS generation, and turnkey submission to US FDA, EU CPNP, Saudi SFDA, or HALAL bodies.'
  },
  {
    step: '05',
    title: 'GMP Manufacturing & QC',
    desc: 'ISO 22716 cleanroom compounding and automated filling. Every batch passes heavy metal, microbial, physical stability, and fill-weight clearance tests.'
  },
  {
    step: '06',
    title: 'Logistics & Post-Launch',
    desc: 'Temperature-controlled packing, export customs handling, international shipping, warehouse delivery, reorder planning, and continuous formula lifecycle updates.'
  }
];

const whyChooseKoreaIn = [
  {
    idx: '01',
    title: 'One-Stop Turnkey Solution',
    desc: 'Full consolidation from chemistry to packaging eliminates fragmented vendor overhead, cutting development time by over 40%.'
  },
  {
    idx: '02',
    title: 'Deep Regulatory Mastery',
    desc: 'In-house regulatory desks directly handle US FDA MoCRA, EU CPNP, Saudi SFDA, and HALAL certifications without third-party bottlenecks.'
  },
  {
    idx: '03',
    title: 'Trend-Driven Speed',
    desc: 'Direct immersion in Seoul’s fast-moving beauty culture allows your brand to adopt viral K-beauty innovations months ahead of global competitors.'
  },
  {
    idx: '04',
    title: 'Bespoke Custom Formulations',
    desc: 'Every formulation is engineered from scratch for your brand’s unique positioning. We never offer commoditized off-the-shelf white labels.'
  },
  {
    idx: '05',
    title: 'Agile Scalability & MOQs',
    desc: 'Flexible initial minimum order quantities tailored for emerging indie prestige brands, scaling seamlessly to multi-million unit retail runs.'
  },
  {
    idx: '06',
    title: 'Collaborative Partnership',
    desc: 'Transparent pricing, open lab communication, and dedicated account leadership focused on building your enduring brand equity.'
  }
];

const regionalAdaptations = [
  {
    region: 'Middle East & Saudi Arabia',
    badge: 'Riyadh & GCC Formulation Desk',
    lead: 'Engineered specifically for extreme arid and high-heat desert environments.',
    points: [
      'Thermal stability verified up to 45°C–50°C without phase separation or sweating',
      'Sweat-resistant, non-comedogenic hydration that does not clog pores in dust or heat',
      'Skin barrier defense and soothing relief against sun exposure and dry winds',
      '100% SFDA & ESMA compliant dossiers and dedicated HALAL certified production lines'
    ]
  },
  {
    region: 'European Union',
    badge: 'Brussels & Paris Regulatory Alignment',
    lead: 'Formulated in total compliance with the world’s strictest cosmetic safety standards.',
    points: [
      'Full conformity with EC Cosmetics Regulation 1223/2009',
      'Zero microplastics, clean preservative systems, and screened natural fragrances',
      'Comprehensive Cosmetic Product Safety Report (CPSR) signed by safety assessors',
      'Turnkey European CPNP notification and Responsible Person (RP) assistance'
    ]
  },
  {
    region: 'United States & North America',
    badge: 'FDA MoCRA Ready',
    lead: 'Clean, trendsetting formulations aligned with major US retail credentialing.',
    points: [
      'Full compliance with the Modernization of Cosmetics Regulation Act (MoCRA)',
      'Clinical efficacy substantiation and dermatological safety verification',
      'Conformity with Sephora Clean, Ulta Conscious Beauty, and Credo standards',
      'Facility registration and cosmetic product listing handled directly by our team'
    ]
  },
  {
    region: 'Southeast Asia',
    badge: 'Tropical Climate Formulations',
    lead: 'Weightless textures tailored for high-humidity and tropical urban climates.',
    points: [
      'Ultralight water-burst and aqueous gel textures with instant absorption',
      'Sebum-control, mattifying botanical actives that combat oily shine in humidity',
      'Broad-spectrum invisible UV protection leaving zero white cast or stickiness',
      'Formulations optimized for ASEAN cosmetic directive standards'
    ]
  }
];

const certificationStandards = [
  {
    title: 'ISO 22716 Good Manufacturing Practice',
    category: 'Manufacturing Standard',
    desc: 'Cleanroom production strictly adhering to international ISO 22716 cosmetic GMP guidelines.',
    points: [
      'Cleanroom manufacturing environments (Class 10,000 & 100,000)',
      'Modern automated compounding, precision filling, and packaging lines',
      'Electronic Batch Production Records ensuring raw material traceability',
      'Stringent in-process quality controls and final batch release testing'
    ]
  },
  {
    title: 'Global Regulatory Dossiers',
    category: 'Market Compliance',
    desc: 'Turnkey registration and compliance dossiers compliant with international cosmetic authorities.',
    points: [
      'US FDA compliance, cosmetic facility registration & MoCRA listing',
      'European Union CPNP notification and Cosmetic Product Safety Reports (CPSR)',
      'Saudi SFDA (eCosma) and UAE ESMA registration dossiers and Certificate of Conformity',
      'Bilingual Arabic/English labeling compliance for Middle Eastern markets'
    ]
  },
  {
    title: 'HALAL Certification',
    category: 'Religious & Ethical Standard',
    desc: 'Audited production verifying 100% alcohol-free and pork-free formulations.',
    points: [
      'Dedicated cleanroom production lines with documented sanitization protocols',
      'Strict raw material screening: 100% free from ethyl alcohol and animal derivatives',
      'Certification alignment for Saudi Arabia, the GCC, and Southeast Asia'
    ]
  },
  {
    title: 'Vegan & Clean Formulation Verification',
    category: 'Conscious Beauty',
    desc: 'Plant-derived formulation integrity meeting leading international clean beauty standards.',
    points: [
      'Certified Vegan verification (Eve Vegan / The Vegan Society standards)',
      'Formulated without parabens, sulfates, phthalates, or microplastics',
      'Cruelty-free verification with zero animal testing'
    ]
  }
];

const qcTestingProcedures = [
  {
    num: '01',
    title: 'Heavy Metal Testing',
    desc: 'Screening for lead, arsenic, mercury, and cadmium to guarantee product purity and consumer safety.'
  },
  {
    num: '02',
    title: 'Microbiological Testing',
    desc: 'Aerobic plate count, yeast, and mold testing verifying sanitary cleanroom conditions across every batch.'
  },
  {
    num: '03',
    title: 'Stability & Compatibility Testing',
    desc: 'Multi-temperature accelerated thermal stability testing and formula-container compatibility studies.'
  },
  {
    num: '04',
    title: 'Leakage & Drop Testing',
    desc: 'Packaging integrity validation, seal hermeticity, pump dispensing accuracy, and calibrated drop tests.'
  }
];
---

<BaseLayout
  title="K-Beauty OEM/ODM Services | KoreaIN"
  description="Specialized OEM/ODM skincare and bio-cosmetics manufacturing by KoreaIN. ISO 22716 GMP cleanrooms, advanced formulation R&D, bespoke packaging, and global regulatory compliance (FDA, CPNP, SFDA, HALAL)."
>
  <main id="main-content" class="oem-portal">
    <!-- Floating Side Dot Navigation (Amorepacific .local-nav) -->
    <nav class="local-nav" aria-label="OEM/ODM page navigation">
      <ul class="local-nav-list">
        {navItems.map((item, index) => (
          <li class={index === 0 ? 'is-current' : ''} data-target={item.id}>
            <a href={`#${item.id}`} class="local-nav-link" aria-label={item.label}>
              <span class="nav-tooltip">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 1. Hero Cover (Full Viewport Cover with Parallax & Smooth Entrance) -->
    <header id="cover" class="cover" aria-labelledby="cover-title">
      <div class="cover-spacer">
        <div
          class="cover-bg"
          id="coverBg"
          style="background-image: url('/home/business-areas/beauty-odm-1-1600.webp');"
        ></div>
        <div class="cover-overlay"></div>
      </div>

      <div class="container cover-content" id="coverContent">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/business-areas">Services</a></li>
            <li aria-current="page">K-Beauty OEM/ODM</li>
          </ol>
        </nav>

        <h1 id="cover-title" class="cover-h">Premium Cosmetics OEM/ODM</h1>
        <p class="cover-subtitle">Where Korean Innovation Meets Global Beauty Excellence</p>

        <div class="cover-desc-group">
          <p class="cover-lead">
            Transform your beauty brand vision into reality with KoreaIN, where Korean innovation meets global excellence in cosmetics manufacturing.
          </p>
          <p class="cover-copy">
            As your dedicated OEM/ODM partner, we deliver premium formulations, regulatory expertise, and comprehensive development services to bring your unique beauty products to market.
          </p>
          <p class="cover-copy">
            From initial lab ideation and formulation chemistry to custom packaging, automated GMP compounding, and international regulatory clearance, we provide an agile, single-source engine for luxury and indie beauty brands worldwide.
          </p>
        </div>

        <div class="cover-action">
          <a href="#contact" class="btn-cover">
            <span>Request Formulation Catalog</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 10h11M11 5l5 5-5 5" />
            </svg>
          </a>
          <a href="/contact" class="btn-cover btn-cover--secondary">
            <span>Schedule a Consultation</span>
          </a>
        </div>
      </div>

      <!-- Animated Mouse Scroll Indicator -->
      <a href="#vision-mission" class="cover-mouse" id="coverMouse" aria-label="Scroll to first section">
        <span class="mouse-icon"></span>
        <span class="mouse-text">Scroll</span>
      </a>
    </header>

    <!-- Main Showcase Sections (Amorepacific Sub-section Choreography) -->
    <div class="page-contents">

      <!-- SECTION 01: Vision & Mission -->
      <section
        id="vision-mission"
        class="sub-section sub-section-banner"
        data-section-id="vision-mission"
        aria-labelledby="vision-title"
      >
        <!-- High Cinematic Visual Banner -->
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/beauty-odm-2-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">01</span>
              <span class="sub-section-category">Vision &amp; Mission</span>
            </span>
            <h2 id="vision-title" class="sub-section-h">
              Empowering Beauty Brands<br />Through Korean Innovation
            </h2>
          </div>
        </div>

        <!-- Spacious Architectural Surface -->
        <div class="sub-section-surface">
          <div class="container">
            <div class="editorial-layout">
              <div class="editorial-lead-box">
                <span class="practice-tag">Strategic Core</span>
                <h3 class="editorial-headline">Global Leadership Grounded in Quality &amp; Trust</h3>
                <blockquote class="editorial-quote">
                  "Our vision is to be the global leader in cosmetics OEM/ODM, combining cutting-edge Korean innovation with world-class quality and trust, empowering beauty brands worldwide to realize their full creative and commercial potential."
                </blockquote>
              </div>

              <div class="dual-core-grid">
                <div class="core-card">
                  <span class="core-card__idx">Vision</span>
                  <h4 class="core-card__title">Global Benchmark of Beauty Innovation</h4>
                  <p class="body-text">
                    To pioneer the future of cosmetics manufacturing by seamlessly uniting Seoul’s rapid formulation breakthroughs with international quality assurance, sustainable chemistry, and enduring commercial value.
                  </p>
                </div>

                <div class="core-card">
                  <span class="core-card__idx">Mission</span>
                  <h4 class="core-card__title">Tailored Performance &amp; Consumer-Centric Design</h4>
                  <p class="body-text">
                    Deliver high-performance, custom-crafted cosmetic solutions through advanced formulation science and regulatory expertise, while fostering sustainable practices, inclusive beauty, and flawless user experiences.
                  </p>
                </div>
              </div>

              <div class="surface-action-row">
                <a href="#competencies" class="sub-section-more">
                  <span>Explore Core Competencies</span>
                  <svg class="more-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M10 4v11M5 11l5 5 5-5" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 02: Core Competencies (Keeps kbeauty_6.png) -->
      <section
        id="competencies"
        class="sub-section sub-section-banner"
        data-section-id="competencies"
        aria-labelledby="competencies-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/oem-lab-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">02</span>
              <span class="sub-section-category">Core Competencies</span>
            </span>
            <h2 id="competencies-title" class="sub-section-h">
              Six Pillars of<br />Manufacturing Excellence
            </h2>
          </div>
        </div>

        <div class="sub-section-surface">
          <div class="container">
            <div class="surface-intro">
              <p class="lead-statement">
                From initial raw material sourcing and custom formulation chemistry to automated compounding, packaging, and international export, KoreaIN operates as a unified, full-spectrum OEM/ODM partner.
              </p>
            </div>

            <div class="competencies-grid">
              {competencies.map((comp) => (
                <article class="competency-card">
                  <div class="competency-card__top">
                    <span class="competency-idx">{comp.idx}</span>
                    <h3 class="competency-title">{comp.title}</h3>
                  </div>
                  <p class="competency-lead">{comp.lead}</p>
                  <ul class="competency-list">
                    {comp.points.map((pt) => (
                      <li>
                        <svg class="check-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M3.5 8.5l3 3 6-7" />
                        </svg>
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>

            <div class="surface-action-row">
              <a href="#categories" class="sub-section-more">
                <span>Browse Product Categories</span>
                <svg class="more-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M10 4v11M5 11l5 5 5-5" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 03: Comprehensive Product Portfolio (Skincare, Bio & Dermacosmetics) -->
      <section
        id="categories"
        class="sub-section"
        data-section-id="categories"
        aria-labelledby="categories-title"
      >
        <div class="container section-title-block">
          <span class="sub-section-meta">
            <span class="sub-section-number">03</span>
            <span class="sub-section-category">Product Portfolio</span>
          </span>
          <h2 id="categories-title" class="section-main-h">
            Precision Formulations Across All Skincare Disciplines
          </h2>
          <p class="section-lead-copy">
            We engineer bespoke skincare formulations tailored to your brand’s aesthetic, skin-feel benchmarks, target retail price, and regulatory markets.
          </p>
        </div>

        <div class="container">
          <!-- Prominent Visual Showcase (beauty_odm image) -->
          <div class="categories-visual-banner-card">
            <figure class="category-visual-banner-figure">
              <img
                src="/home/business-areas/beauty-odm-3-1200.webp"
                alt="High-performance skincare laboratory bottles, droppers, and concentrated bio-serums."
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                class="category-visual-img"
              />
            </figure>
            <div class="category-visual-banner-caption">
              <span class="visual-badge">Clinical &amp; Botanical</span>
              <h3 class="category-visual-title">High-Efficacy Dermacosmetics &amp; Skincare Formulations</h3>
              <p>Active bio-serums, multi-layer lipid barrier creams, bio-fermented essences, and certified clean beauty solutions.</p>
            </div>
          </div>

          <!-- 4 Detailed Skincare Category Breakdowns -->
          <div class="categories-detail-grid">
            <!-- 1. Serums & Ampoules -->
            <article class="category-detail-card">
              <div class="category-detail-header">
                <span class="category-idx">01</span>
                <h3 class="category-detail-title">Bio-Active Serums &amp; Ampoules</h3>
              </div>
              <p class="category-detail-lead">
                Highly concentrated targeted treatments engineered for cellular hydration, radiance, and barrier recovery.
              </p>
              <div class="category-tags-list">
                <div class="tag-row">
                  <span class="tag-label">Active Complexes</span>
                  <span class="tag-items">Multi-weight Hyaluronic Acid, encapsulated Pure Ascorbic Acid (Vitamin C), stabilized Retinol, and botanical Bakuchiol</span>
                </div>
                <div class="tag-row">
                  <span class="tag-label">Skin Elasticity</span>
                  <span class="tag-items">Biomimetic multi-peptide complexes, marine collagen boosters, and copper tripeptide firming elixirs</span>
                </div>
              </div>
            </article>

            <!-- 2. Moisturizers & Emulsions -->
            <article class="category-detail-card">
              <div class="category-detail-header">
                <span class="category-idx">02</span>
                <h3 class="category-detail-title">Moisturizers &amp; Barrier Creams</h3>
              </div>
              <p class="category-detail-lead">
                Formulations restoring the skin's lipid barrier while delivering lightweight, non-greasy absorption.
              </p>
              <div class="category-tags-list">
                <div class="tag-row">
                  <span class="tag-label">Barrier Restoration</span>
                  <span class="tag-items">Ceramide lamellar barrier creams (Ceramides NP, AP, EOP), cholesterol-infused emulsions, and lipid recovery balms</span>
                </div>
                <div class="tag-row">
                  <span class="tag-label">Climate Textures</span>
                  <span class="tag-items">Cooling aqueous water-burst gel-creams, weightless daily hydration fluid emulsions, and overnight recovery balms</span>
                </div>
              </div>
            </article>

            <!-- 3. Cleansers, Toners & Masks -->
            <article class="category-detail-card">
              <div class="category-detail-header">
                <span class="category-idx">03</span>
                <h3 class="category-detail-title">Cleansers, Toners &amp; Sheet Masks</h3>
              </div>
              <p class="category-detail-lead">
                Dermatological preparation steps maintaining healthy skin pH and barrier equilibrium.
              </p>
              <div class="category-tags-list">
                <div class="tag-row">
                  <span class="tag-label">Cleansing Formats</span>
                  <span class="tag-items">Melting sherbet cleansing balms, micellar cleansing waters, and low-pH amino acid gentle foaming washes</span>
                </div>
                <div class="tag-row">
                  <span class="tag-label">Essences &amp; Masks</span>
                  <span class="tag-items">Bio-fermented first essences, PHA gentle clarifying toners, bio-cellulose sheet masks, and cooling hydrogel eye patches</span>
                </div>
              </div>
            </article>

            <!-- 4. Next-Gen Formats & Functional Lines -->
            <article class="category-detail-card">
              <div class="category-detail-header">
                <span class="category-idx">04</span>
                <h3 class="category-detail-title">Next-Gen Formats &amp; Certified Lines</h3>
              </div>
              <p class="category-detail-lead">
                Sustainable, preservative-free formats and certified ethical lines meeting global consumer standards.
              </p>
              <div class="category-tags-list">
                <div class="tag-row">
                  <span class="tag-label">Innovative Formats</span>
                  <span class="tag-items">Waterless solid face balms, powder-to-liquid active treatments, portable skincare stick balms, and single-dose biodegradable plant capsules</span>
                </div>
                <div class="tag-row">
                  <span class="tag-label">Certified Profiles</span>
                  <span class="tag-items">100% certified Vegan (Eve Vegan), hypoallergenic sensitive skin formulations (Cica complex), and certified alcohol-free HALAL production lines</span>
                </div>
              </div>
            </article>
          </div>

          <div class="surface-action-row">
            <a href="#formulation" class="sub-section-more">
              <span>Explore Formulation Science</span>
              <svg class="more-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M10 4v11M5 11l5 5 5-5" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- SECTION 04: Formulation & Texture Engineering Deep-Dive -->
      <section
        id="formulation"
        class="sub-section sub-section-banner"
        data-section-id="formulation"
        aria-labelledby="formulation-title"
      >
        <div class="sub-section-header sub-section-header--tall" style="background-image: url('/home/business-areas/beauty-odm-4-1600.webp');">
          <div class="sub-section-header__overlay"></div>
          <div class="sub-section-deco" aria-hidden="true"></div>

          <div class="sub-section-title-wrap">
            <span class="sub-section-meta">
              <span class="sub-section-number">04</span>
              <span class="sub-section-category">Formulation Science</span>
            </span>
            <h2 id="formulation-title" class="sub-section-h">
