    z-index: 1;
  }

  .sub-section-deco {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.45);
    z-index: 2;
    transition: width 1100ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sub-section.is-active .sub-section-deco {
    width: clamp(2rem, 8vw, 8rem);
  }

  .sub-section-title-wrap {
    position: relative;
    z-index: 3;
    max-width: 52rem;
    color: #ffffff;
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1) 200ms, transform 900ms cubic-bezier(0.16, 1, 0.3, 1) 200ms;
  }

  .sub-section.is-active .sub-section-title-wrap {
    opacity: 1;
    transform: translateY(0);
  }

  .sub-section-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
