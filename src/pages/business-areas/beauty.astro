---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="K-Beauty Innovation & Global Distribution | KoreaIN"
  description="Connecting top-tier Korean skincare brands, bio-cosmetic manufacturers, and OEM/ODM laboratories with high-growth international consumer markets."
>
  <main id="main-content" class="page-sector">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li><a href="/business-areas">Business Areas</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">Beauty</li>
          </ol>
        </nav>

        <div class="page-hero__grid">
          <div class="page-hero__text">
            <h1 class="page-title">K-Beauty &amp; Bio-Cosmetic Innovation</h1>
            <p class="page-lead">
              South Korea is the undisputed global leader in dermatological research, cosmetic formulation science, and viral beauty product trends. KoreaIN facilitates full-scale brand exports, OEM/ODM laboratory partnerships, and regional distribution across the Middle East and global retail ecosystems.
            </p>
            <div class="hero-actions">
              <a href="/contact" class="button button--primary">
                <span>Explore Beauty Distribution</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 10h11M11 5l5 5-5 5" />
                </svg>
              </a>
              <a href="/business-areas" class="button button--secondary">
                <span>All Business Areas</span>
              </a>
            </div>
          </div>

          <div class="page-hero__stats">
            <div class="stat-card">
              <span class="stat-card__number">OEM / ODM</span>
              <span class="stat-card__label">Direct Lab &amp; Cleanroom Sourcing</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Regulatory</span>
              <span class="stat-card__label">SFDA &amp; Halal Compliance Experts</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Omnichannel</span>
              <span class="stat-card__label">E-Commerce, Pharmacies &amp; Retail</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Formula</span>
              <span class="stat-card__label">Bespoke Climate-Adapted Skincare</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Visual Showcase: Existing Beauty Image & Black Placeholder -->
    <section class="section visual-section">
      <div class="container visual-grid">
        <div class="visual-card">
          <figure class="visual-figure">
            <img
              src="/home/business-areas/beauty.webp"
              alt="Premium minimalist skincare glass bottles and serum droppers on polished marble."
              width="960"
              height="643"
              loading="lazy"
              decoding="async"
              class="visual-img"
            />
          </figure>
          <div class="visual-caption">
            <span class="visual-caption__tag">Bio-Cosmetics</span>
            <p>Premium medical-grade formulations &amp; minimalist cosmetic design</p>
          </div>
        </div>

        <div class="black-placeholder" aria-label="Laboratory formulation placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">Cosmetic Formulation &amp; Certified Cleanroom Laboratory — Pending Selection</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Strategic Narrative -->
    <section class="section strategic-overview">
      <div class="container">
        <div class="split-overview">
          <div class="split-overview__lead">
            <h2 class="section-title">From Seoul Formulation to Middle Eastern Retail</h2>
          </div>
          <div class="split-overview__body">
            <p class="section-copy">
              K-Beauty has evolved from a regional trend into an enduring international benchmark for skincare innovation, backed by sophisticated biomimetic ingredients, botanical ferments, and gentle, clinical-grade active substances.
            </p>
            <p class="section-copy">
              Saudi Arabia and the Gulf region represent one of the world's highest per-capita cosmetic consumption markets. KoreaIN works directly with regional powerhouses (including Nice One Saudi, Care Outlet, and major pharmacy groups) to curate, register, and distribute proven Korean skincare lines adapted specifically to regional climates and consumer preferences.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Pillars -->
    <section class="section pillars-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">End-to-End Cosmetic Solutions</h2>
          <p class="section-copy">
            Turnkey sourcing, compliance, and distribution connecting Korean cosmetic science with global markets.
          </p>
        </header>

        <div class="pillars-grid">
          <article class="pillar-card">
            <div class="pillar-card__index">01</div>
            <h3 class="pillar-card__title">OEM / ODM Laboratory Sourcing</h3>
            <p class="pillar-card__copy">
              Direct partnership access to Korea's premier GMP and ISO-certified cosmetic laboratories, providing private label manufacturing and proprietary formulation development.
            </p>
            <ul class="pillar-card__list">
              <li>Custom texture, active ingredient, and fragrance scoping</li>
              <li>Eco-friendly and sustainable packaging sourcing</li>
              <li>Small batch prototyping and industrial scale production</li>
            </ul>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__index">02</div>
            <h3 class="pillar-card__title">Regulatory &amp; SFDA Compliance</h3>
            <p class="pillar-card__copy">
              Navigating Middle Eastern and international health authority requirements, including Saudi Food and Drug Authority (SFDA) eCosma registration and Halal product compliance.
            </p>
            <ul class="pillar-card__list">
              <li>Laboratory safety dossiers &amp; ingredient screening</li>
              <li>SFDA eCosma product registration management</li>
              <li>Bilingual Arabic/English labeling compliance</li>
            </ul>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__index">03</div>
            <h3 class="pillar-card__title">Omnichannel Retail &amp; E-Commerce</h3>
            <p class="pillar-card__copy">
              Securing prominent placement across high-performing GCC beauty platforms, specialty retail stores, duty-free outlets, and direct-to-consumer digital channels.
            </p>
            <ul class="pillar-card__list">
              <li>Direct merchant placement on regional marketplaces</li>
              <li>Specialty pharmacy network distribution</li>
              <li>Localized marketing and influencer brand activations</li>
            </ul>
          </article>

          <article class="pillar-card">
            <div class="pillar-card__index">04</div>
            <h3 class="pillar-card__title">Climate Adaptation &amp; Bio-Formulas</h3>
            <p class="pillar-card__copy">
              Developing specialized skincare formulas specifically engineered for high-temperature, arid climates—incorporating ultra-light hydration, barrier repair, and advanced SPF protection.
            </p>
            <ul class="pillar-card__list">
              <li>High-durability broad-spectrum UV protection</li>
              <li>Ceramide and peptide moisture barrier restoration</li>
              <li>Non-comedogenic cooling formulation technology</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- Next Steps CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Expand Your Beauty Portfolio with Korea</h2>
          <p class="cta-card__copy">
            Whether you seek wholesale distribution of proven K-Beauty brands or custom formulation with leading laboratories, KoreaIN delivers the verified bilateral gateway.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Initiate Beauty Sourcing</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/business-areas" class="button button--secondary">
              <span>Explore All Sectors</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-actions svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .page-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 8rem;
  }

  .stat-card__number {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .stat-card__label {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* Visual Section */
  .visual-section {
    padding-top: clamp(2.5rem, 4.5vw, 4rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  .visual-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .visual-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .visual-figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-caption {
    padding: 1.25rem 1.75rem;
  }

  .visual-caption__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .visual-caption p {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .black-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }

  .black-placeholder__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  .black-placeholder__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .black-placeholder__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .black-placeholder__note {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 22rem;
  }

  /* Split Overview */
  .strategic-overview {
    background: var(--color-surface);
  }

  .split-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .split-overview__lead .section-title {
    margin-top: 0.5rem;
  }

  .split-overview__body p + p {
    margin-top: 1.5rem;
  }

  /* Pillars Section */
  .section-header {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .pillar-card {
    padding: clamp(2rem, 3.5vw, 2.75rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-secondary) 40%, var(--color-border));
  }

  .pillar-card__index {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 1.25rem;
  }

  .pillar-card__title {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .pillar-card__copy {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .pillar-card__list {
    padding-left: 1.2rem;
    margin: 0;
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }


  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .page-hero__grid {
      grid-template-columns: 1fr;
    }

    .visual-grid {
      grid-template-columns: 1fr;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .split-overview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .page-hero__stats {
      grid-template-columns: 1fr;
    }
  }
</style>