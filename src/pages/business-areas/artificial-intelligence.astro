---
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  {
    id: 'artificial-intelligence',
    type: 'banner',
    title: 'Artificial Intelligence & AI Solutions',
    lead: 'Helping organizations evaluate, implement, and benefit from practical artificial intelligence that improves operational performance.',
    description: 'KoreaIN works alongside enterprise leadership to integrate artificial intelligence into core business activities. Rather than treating AI as an isolated experiment, we focus on practical adoption—applying intelligent automation, data-driven forecasting, and modern cognitive tools to enhance productivity, streamline complex workflows, and unlock value from enterprise data.',
    bgImage: '/home/technology/ai-applications-1200.webp',
    capabilities: [
      'Enterprise AI Strategy & Implementation',
      'Workflow Automation & Intelligent Processing',
      'Data Analytics & Practical Insights',
      'Cognitive Business Applications'
    ]
  },
  {
    id: 'software-development',
    type: 'split',
    isReversed: false,
    title: 'Software Development',
    lead: 'Custom enterprise software, web applications, and digital platforms engineered for performance and scalability.',
    description: 'We design and develop bespoke software solutions tailored to your operational requirements. From customer-facing platforms to internal enterprise tools, KoreaIN delivers clean, scalable architectures that support organizational growth, streamline operations, and integrate seamlessly with existing systems.',
    imageName: 'software',
    imageWidth: 1200,
    imageHeight: 675,
    altText: 'Software development workspace showcasing enterprise application engineering and modern code architecture',
    capabilities: [
      'Custom Enterprise Software Engineering',
      'Web & Mobile Application Development',
      'API & Service Architecture',
      'Legacy System Modernization'
    ]
  },
  {
    id: 'cloud-solutions',
    type: 'banner',
    title: 'Cloud Solutions & Infrastructure',
    lead: 'Scalable cloud architectures, seamless migration, and ongoing environment management tailored to business needs.',
    description: 'KoreaIN assists companies with every phase of cloud adoption. Whether migrating legacy workloads, designing hybrid environments, or optimizing existing infrastructure, we deliver secure, cost-effective environments that ensure high availability and business agility.',
    bgImage: '/home/technology/cloud-1200.webp',
    capabilities: [
      'Cloud Strategy & Migration Planning',
      'Hybrid & Multi-Cloud Architecture',
      'Infrastructure Management & Monitoring',
      'Resource Optimization & Scaling'
    ]
  },
  {
    id: 'it-infrastructure',
    type: 'split',
    isReversed: true,
    title: 'IT Infrastructure & Network Solutions',
    lead: 'Dependable corporate networking, server systems, and workplace connectivity that keep operations running smoothly.',
    description: 'Reliable day-to-day operations require stable, well-maintained IT infrastructure. KoreaIN designs, deploys, and supports enterprise networks, server environments, and communications systems to ensure secure, low-latency connectivity across office and remote locations.',
    imageName: 'infrastructure',
    imageWidth: 1200,
    imageHeight: 675,
    altText: 'Enterprise data center and high-throughput corporate network routing infrastructure',
    capabilities: [
      'Enterprise Network Design & Implementation',
      'Server & Storage Infrastructure',
      'Multi-Site & Workplace Connectivity',
      'Network Monitoring & Recovery Planning'
    ]
  },
  {
    id: 'cybersecurity',
    type: 'banner',
    title: 'Cybersecurity & Data Protection',
    lead: 'Multi-layered security strategies and data governance to protect critical business assets and confidential information.',
    description: 'Protecting digital assets and maintaining stakeholder trust is central to every modern organization. KoreaIN implements structured security frameworks, access controls, and data protection measures that safeguard enterprise systems against vulnerabilities, disruptions, and unauthorized access.',
    bgImage: '/home/technology/security-1200.webp',
    capabilities: [
      'Enterprise Threat Prevention & Defense',
      'Data Privacy & Access Management',
      'Security Risk Assessments & Audits',
      'Incident Response & Business Continuity'
    ]
  },
  {
    id: 'system-integration',
    type: 'split',
    isReversed: false,
    title: 'System Integration & Digital Transformation',
    lead: 'Connecting disparate platforms and automating cross-functional workflows into a unified digital environment.',
    description: 'Disconnected software creates bottlenecks and manual overhead. KoreaIN integrates heterogeneous enterprise systems—including ERP, CRM, and operational databases—enabling real-time data flow, eliminating duplicate processes, and advancing overall digital transformation.',
    imageName: 'integration',
    imageWidth: 1200,
    imageHeight: 675,
    altText: 'System integration architecture showing interconnected enterprise platforms and synchronized data streams',
    capabilities: [
      'Enterprise Systems & Database Integration',
      'Workflow & Business Process Automation',
      'Centralized Data Synchronization',
      'Digital Transformation Execution'
    ]
  },
  {
    id: 'it-consulting',
    type: 'banner',
    title: 'IT Consulting & Managed Services',
    lead: 'Strategic guidance and proactive technical management that align technology investments with business objectives.',
    description: 'Navigating technology decisions requires seasoned perspective and consistent execution. KoreaIN provides strategic technology consulting alongside ongoing managed IT support, helping organizations plan their technology roadmaps, manage IT operations, and resolve technical challenges with dependable continuity.',
    bgImage: '/home/technology/consulting-1200.webp',
    capabilities: [
      'Strategic IT Planning & Advisory',
      'Comprehensive IT Operations Management',
      'Infrastructure Maintenance & Support',
      'Technology Sourcing & Vendor Coordination'
    ]
  }
];

const navChapters = [
  { id: 'hero', label: 'Overview' },
  { id: 'delivery-model', label: 'Architecture' },
  { id: 'artificial-intelligence', label: 'AI Solutions' },
  { id: 'software-development', label: 'Software Development' },
  { id: 'cloud-solutions', label: 'Cloud Solutions' },
  { id: 'it-infrastructure', label: 'IT Infrastructure' },
  { id: 'cybersecurity', label: 'Cybersecurity' },
  { id: 'system-integration', label: 'System Integration' },
  { id: 'it-consulting', label: 'IT Consulting' },
  { id: 'contact-technology', label: 'Contact' }
];
---

<BaseLayout
  title="IT Consulting, Technology Solutions & AI Services | KoreaIN"
  description="KoreaIN provides comprehensive IT consulting, technology solutions, custom software development, cloud infrastructure, cybersecurity, system integration, and AI services."
>
  <main id="main-content" class="tech-page">
    <!-- Floating Side Dot Navigation (Amorepacific .local-nav) -->
    <nav class="local-nav" aria-label="Page navigation">
      <ul class="local-nav-list">
        {navChapters.map((item, index) => (
          <li class={index === 0 ? 'is-current' : ''} data-target={item.id}>
            <a href={`#${item.id}`} class="local-nav-link" aria-label={item.label}>
              <span class="nav-dot"></span>
              <span class="nav-tooltip">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 1. Hero Cover Section -->
    <header id="hero" class="tech-hero" aria-labelledby="tech-hero-title">
      <div class="tech-hero__background">
        <picture>
          <source media="(min-width: 960px)" srcset="/home/technology/hero-1920.webp" width="1920" height="1079" />
          <img
            src="/home/technology/hero-1920.webp"
            srcset="/home/technology/hero-960.webp 960w, /home/technology/hero-1920.webp 1920w"
            sizes="100vw"
            width="1920"
            height="1079"
            alt="Advanced corporate technology and cognitive computing infrastructure engineered by KoreaIN"
            fetchpriority="high"
            decoding="async"
            class="tech-hero__image"
          />
        </picture>
        <div class="tech-hero__scrim"></div>
      </div>

      <div class="container tech-hero__container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/business-areas">Business Areas</a></li>
            <li aria-current="page">Technology &amp; AI</li>
          </ol>
        </nav>

        <div class="tech-hero__content">
          <h1 id="tech-hero-title" class="tech-hero__heading">
            Technology Solutions,<br />
            <span>IT Consulting &amp; AI Services.</span>
          </h1>
          <p class="tech-hero__lead">
            KoreaIN delivers end-to-end technology services, from custom enterprise software development and scalable cloud infrastructure to cybersecurity, system integration, and practical artificial intelligence.
          </p>
          <p class="tech-hero__description">
            We operate as a trusted technology partner for organizations requiring dependable engineering, operational continuity, and sound digital execution across South Korea, Saudi Arabia, and international markets.
          </p>

          <div class="tech-hero__actions">
            <a class="tech-btn tech-btn--light" href="/contact">
              Discuss Your Project
              <span aria-hidden="true">↗</span>
            </a>
            <a class="tech-link tech-link--on-dark" href="#delivery-model">
              Explore Our Services
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <a href="#delivery-model" class="tech-hero__scroll" aria-label="Scroll to architecture overview">
        <span class="tech-hero__mouse"></span>
        <span class="tech-hero__scroll-text">Scroll</span>
      </a>
    </header>

    <!-- Chapter Horizontal Navigation Bar -->
    <nav class="chapter-nav" aria-label="Technology service areas">
      <div class="container chapter-nav__inner">
        <a href="#artificial-intelligence">AI Solutions</a>
        <a href="#software-development">Software Development</a>
        <a href="#cloud-solutions">Cloud Infrastructure</a>
        <a href="#it-infrastructure">IT &amp; Networks</a>
        <a href="#cybersecurity">Cybersecurity</a>
        <a href="#system-integration">System Integration</a>
        <a href="#it-consulting">IT Consulting</a>
      </div>
    </nav>

    <!-- 2. Integrated Delivery Model (Amorepacific About-Page Scroll) -->
    <section
      id="delivery-model"
      class="sub-section sub-section-banner"
      data-section-id="delivery-model"
      aria-labelledby="delivery-title"
    >
      <div class="sub-section-header" style="background-image: url('/home/technology/ai-network-1200.webp');">
        <div class="sub-section-header__overlay"></div>
        <div class="sub-section-deco" aria-hidden="true"></div>
        <div class="sub-section-title-wrap">
          <h2 id="delivery-title" class="sub-section-h">
            A Unified Approach<br />to Enterprise Technology
          </h2>
        </div>
      </div>

      <div class="sub-section-content-container">
        <div class="container">
          <div class="sub-section-content">
            <div class="content-left">
              <p class="lead-statement">
                KoreaIN connects strategic IT consulting with dependable engineering execution, providing organizations with a single source of accountability across their digital ecosystem.
              </p>
              <p class="body-text">
                Enterprise technology functions best as an integrated whole. Modern applications depend on resilient cloud and network infrastructure, data protection requires consistent security practices, and practical artificial intelligence relies on sound data management. By addressing each component with cohesive engineering oversight, we help clients build reliable systems that support sustained commercial growth.
              </p>
              <div class="delivery-pillars">
                <div class="delivery-pillar">
                  <h3>End-to-End Ownership</h3>
                  <p>Direct responsibility from initial scoping and architecture through deployment, integration, and ongoing operational maintenance.</p>
                </div>
                <div class="delivery-pillar">
                  <h3>Practical Engineering</h3>
                  <p>Solutions built on proven enterprise standards, maintainable codebases, and realistic operational requirements.</p>
                </div>
                <div class="delivery-pillar">
                  <h3>Cross-Border Support</h3>
                  <p>Extensive experience supporting bilateral business initiatives between South Korea, Saudi Arabia, and international partners.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Seven Core Technology Services (Amorepacific About-Page Scroll Banners + Asymmetric Splits) -->
    <div class="services-feed">
      {services.map((service) => {
        if (service.type === 'banner') {
          return (
            <section
              id={service.id}
              class="sub-section sub-section-banner"
              data-section-id={service.id}
              aria-labelledby={`${service.id}-title`}
            >
              <div
                class="sub-section-header"
                style={`background-image: url('${service.bgImage}');`}
              >
                <div class="sub-section-header__overlay"></div>
                <div class="sub-section-deco" aria-hidden="true"></div>
                <div class="sub-section-title-wrap">
                  <h2 id={`${service.id}-title`} class="sub-section-h">
                    {service.title}
                  </h2>
                </div>
              </div>

              <div class="sub-section-content-container">
                <div class="container">
                  <div class="sub-section-content">
                    <div class="content-left">
                      <p class="lead-statement">{service.lead}</p>
                      <p class="body-text">{service.description}</p>
                    </div>
                    <div class="content-right">
                      <ul class="focus-list" aria-label={`${service.title} focus areas`}>
                        {service.capabilities.map((item) => (
                          <li>
                            <span class="focus-marker" aria-hidden="true">—</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          );
        }

        return (
          <section
            id={service.id}
            class={`tech-section split-section ${service.isReversed ? 'split-section--inverted' : ''}`}
            data-section-id={service.id}
            aria-labelledby={`${service.id}-title`}
          >
            <div class="container">
              <div class={`editorial-split ${service.isReversed ? 'editorial-split--inverted' : ''} reveal-on-scroll`}>
                <div class="editorial-copy">
                  <h2 id={`${service.id}-title`} class="section-heading">
                    {service.title}
                  </h2>
                  <p class="editorial-lead">{service.lead}</p>
                  <p class="editorial-body">{service.description}</p>

                  <div class="capabilities-block">
                    <ul class="focus-list" aria-label={`${service.title} focus areas`}>
                      {service.capabilities.map((item) => (
                        <li>
                          <span class="focus-marker" aria-hidden="true">—</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="editorial-visual">
                  <div class="visual-frame">
                    <picture>
                      <source media="(min-width: 768px)" srcset={`/home/technology/${service.imageName}-1200.webp`} width={service.imageWidth} height={service.imageHeight} />
                      <img
                        src={`/home/technology/${service.imageName}-1200.webp`}
                        srcset={`/home/technology/${service.imageName}-640.webp 640w, /home/technology/${service.imageName}-1200.webp 1200w`}
                        sizes="(max-width: 1024px) 100vw, 55vw"
                        width={service.imageWidth}
                        height={service.imageHeight}
                        loading="lazy"
                        decoding="async"
                        alt={service.altText}
                        class="visual-image"
                      />
                    </picture>
                  </div>
                </div>
              </div>
            </div>
          </section>
        );
      })}
    </div>

    <!-- 4. Closing Strategic Engagement Section -->
    <section id="contact-technology" class="tech-section tech-contact" aria-labelledby="contact-title">
      <div class="container">
        <div class="contact-editorial reveal-on-scroll">
          <div class="contact-editorial__copy">
            <h2 id="contact-title" class="contact-editorial__heading">
              Partner with KoreaIN for Your Technology Initiatives.
            </h2>
            <p class="contact-editorial__lead">
              Whether developing custom enterprise software, migrating infrastructure to the cloud, strengthening cybersecurity, or exploring practical AI adoption, KoreaIN provides dependable technology services designed around your business goals.
            </p>
            <p class="contact-editorial__body">
              Contact our team to discuss project requirements, technical scoping, and implementation schedules.
            </p>
          </div>

          <div class="contact-editorial__actions">
            <a class="tech-btn tech-btn--primary" href="/contact">
              Discuss Your Project
              <span aria-hidden="true">↗</span>
            </a>
            <a class="tech-link" href="/business-areas">
              Explore All Business Areas
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Amorepacific Section Observer (triggers .is-active for background banners & lines)
    const sections = Array.from(document.querySelectorAll('.sub-section, header#hero, section.tech-section'));
    const navItems = Array.from(document.querySelectorAll('.local-nav-list li'));

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            const id = entry.target.id;
            navItems.forEach((li) => {
              if (li.getAttribute('data-target') === id) {
                li.classList.add('is-current');
              } else {
                li.classList.remove('is-current');
              }
            });
          }
        });
      },
      {
        root: null,
        rootMargin: '-15% 0px -25% 0px',
        threshold: [0.1, 0.35]
      }
    );

    sections.forEach((sec) => sectionObserver.observe(sec));

    // 2. Reveal on scroll for split sections
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
      );

      revealElements.forEach((el) => {
        el.classList.add('reveal-prep');
        revealObserver.observe(el);
      });
    }

    // 3. Smooth scroll handling for internal links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

<style>
  /* ==========================================================================
     KoreaIN Enterprise Technology & Artificial Intelligence
     Amorepacific-Inspired Refined Editorial Layout & Background Scroll Parallax
     ========================================================================== */

  .tech-page {
    background: var(--color-bg);
    color: var(--color-text);
    overflow-x: clip;
  }

  .tech-page h1,
  .tech-page h2,
  .tech-page h3 {
    text-wrap: balance;
    margin: 0;
  }

  .tech-page p {
    text-wrap: pretty;
  }

  /* --------------------------------------------------------------------------
     Floating Side Dot Navigation (Amorepacific .local-nav)
     -------------------------------------------------------------------------- */
  .local-nav {
    display: none;
    position: fixed;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
  }

  @media (min-width: 1280px) {
    .local-nav {
      display: block;
    }
  }

  .local-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .local-nav-list li {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .local-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    text-decoration: none;
  }

  .nav-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
    opacity: 0.4;
    transition: transform 240ms ease, opacity 240ms ease, background-color 240ms ease;
  }

  .local-nav-link:hover .nav-dot,
  .local-nav-list li.is-current .nav-dot {
    opacity: 1;
    background: var(--color-primary);
    transform: scale(1.6);
  }

  .local-nav-list li.is-current .nav-dot {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 25%, transparent);
  }

  .nav-tooltip {
    position: absolute;
    right: 2rem;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-text);
    background: var(--color-surface);
    padding: 0.35rem 0.75rem;
    border-radius: 2px;
    border: 1px solid var(--color-border);
    opacity: 0;
    pointer-events: none;
    transform: translateX(8px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .local-nav-link:hover .nav-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  /* --------------------------------------------------------------------------
     Hero Cover Section
     -------------------------------------------------------------------------- */
  .tech-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-height) + clamp(2rem, 4vw, 3.5rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: #050722;
    color: #ffffff;
    overflow: hidden;
  }

  .tech-hero__background {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .tech-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    filter: brightness(0.68) contrast(1.08);
  }

  .tech-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 7, 34, 0.75) 0%,
      rgba(5, 7, 34, 0.45) 40%,
      rgba(5, 7, 34, 0.85) 100%
    );
  }

  .tech-hero__container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .breadcrumbs {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.6rem;
    opacity: 0.4;
  }

  .breadcrumbs a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: #ffffff;
  }

  .breadcrumbs [aria-current="page"] {
    color: #ffffff;
    font-weight: 500;
  }

  .tech-hero__content {
    max-width: 54rem;
  }

  .tech-hero__heading {
    font-size: clamp(2.5rem, 5.2vw, 4.75rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .tech-hero__heading span {
    color: #a6b8ff;
  }

  .tech-hero__lead {
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.6;
    color: #e4e8f7;
    margin: 0 0 1.25rem;
    max-width: 48rem;
  }

  .tech-hero__description {
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.7;
    color: #b6bed1;
    margin: 0 0 clamp(2rem, 3.5vw, 3rem);
    max-width: 44rem;
  }

  .tech-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .tech-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.9375rem 1.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1;
    transition: background-color 200ms ease, color 200ms ease, transform 200ms ease;
  }

  .tech-btn--light {
    background: #ffffff;
    color: #050722;
  }

  .tech-btn--light:hover {
    background: #eef1f7;
    transform: translateY(-2px);
  }

  .tech-btn--primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .tech-btn--primary:hover {
    background: var(--color-secondary);
    transform: translateY(-2px);
  }

  .tech-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .tech-link--on-dark {
    color: #ffffff;
  }

  .tech-link:hover {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  .tech-link--on-dark:hover {
    color: #a6b8ff;
    transform: translateY(3px);
  }

  .tech-hero__scroll {
