---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About KoreaIN | Connecting Korea to Global Opportunities"
  description="Learn about KoreaIN's mission, leadership, and strategic role as the premier bilateral bridge between South Korea and international high-growth markets."
>
  <main id="main-content" class="page-about">
    <!-- Hero Section -->
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-hidden="true">/</span></li>
            <li>Company</li>
            <li><span aria-hidden="true">/</span></li>
            <li aria-current="page">About KoreaIN</li>
          </ol>
        </nav>

        <div class="page-hero__grid">
          <div class="page-hero__text">
            <h1 class="page-title">The Bilateral Bridge Between Korea and the World</h1>
            <p class="page-lead">
              KoreaIN connects Korean corporations, technological pioneers, and visionary entrepreneurs with trusted international partners across Saudi Arabia, the Middle East, and global markets.
            </p>
            <div class="hero-actions">
              <a href="#leadership" class="button button--primary">
                <span>Meet Our Leadership</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M10 4v12M4 10l6 6 6-6" />
                </svg>
              </a>
              <a href="/global-markets" class="button button--secondary">
                <span>Explore Global Reach</span>
              </a>
            </div>
          </div>

          <div class="page-hero__stats">
            <div class="stat-card">
              <span class="stat-card__number">Bilateral</span>
              <span class="stat-card__label">Dedicated Korea - Middle East Focus</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Council</span>
              <span class="stat-card__label">Saudi-Korea Business Council Affiliation</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">5 Sectors</span>
              <span class="stat-card__label">High-Impact Growth &amp; Tech Verticals</span>
            </div>
            <div class="stat-card">
              <span class="stat-card__number">Global</span>
              <span class="stat-card__label">Active Expansion &amp; Advisory Presence</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Visual Showcase: Cities & Black Placeholder -->
    <section class="section visual-section">
      <div class="container visual-grid">
        <div class="visual-card">
          <figure class="visual-figure">
            <img
              src="/home/who-we-are/korea_background-800.webp"
              srcset="/home/who-we-are/korea_background-800.webp 800w, /home/who-we-are/korea_background-1600.webp 1600w"
              sizes="(min-width: 1440px) 776px, (min-width: 768px) 50vw, 90vw"
              alt="Seoul skyline at dusk with N Seoul Tower."
              width="3604"
              height="2400"
              loading="lazy"
              decoding="async"
              class="visual-img"
            />
          </figure>
          <div class="visual-caption">
            <span class="visual-caption__tag">Seoul Headquarters</span>
            <p>At the center of Korea's technological and industrial ecosystem</p>
          </div>
        </div>

        <div class="black-placeholder" aria-label="Corporate headquarters visual placeholder">
          <div class="black-placeholder__content">
            <span class="black-placeholder__dot"></span>
            <span class="black-placeholder__tag">Visual Placeholder</span>
            <p class="black-placeholder__note">KoreaIN Executive Team &amp; Bilateral Operations Hub — Pending Photography</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who We Are / Narrative -->
    <section class="section story-section">
      <div class="container">
        <div class="split-overview">
          <div class="split-overview__lead">
            <h2 class="section-title">Why KoreaIN Was Founded</h2>
          </div>
          <div class="split-overview__body">
            <p class="section-copy">
              In an interconnected global economy, the Republic of Korea stands as an unmatched powerhouse of technological innovation, advanced manufacturing, and cultural resonance. Concurrently, the Kingdom of Saudi Arabia and the broader Gulf Cooperation Council (GCC) are executing historic, multi-trillion-dollar economic transformations under visions such as Saudi Vision 2030.
            </p>
            <p class="section-copy">
              Yet traditional cross-border expansion often falters due to institutional cultural gaps, complex regulatory environments, and lack of trusted on-the-ground execution. KoreaIN was established to dissolve these barriers. We provide the permanent, high-integrity commercial corridor that transforms bilateral ambitions into operational joint ventures, capital deployments, and market leadership.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision & Values -->
    <section class="section values-section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">The Pillars of Our Engagement</h2>
          <p class="section-copy">
            Every cross-border initiative we architect is governed by four core commitments.
          </p>
        </header>

        <div class="values-grid">
          <div class="value-card">
            <span class="value-card__num">01</span>
            <h3 class="value-card__title">Deep Cultural &amp; Commercial Fluency</h3>
            <p class="value-card__copy">
              We operate natively within Korean chaebol and venture circles while possessing decades of executive familiarity with Middle Eastern corporate and sovereign customs.
            </p>
          </div>

          <div class="value-card">
            <span class="value-card__num">02</span>
            <h3 class="value-card__title">Direct C-Suite &amp; Regulatory Access</h3>
            <p class="value-card__copy">
              We eliminate intermediaries. Our engagements connect top enterprise executives, institutional allocators, and trade ministry officials directly.
            </p>
          </div>

          <div class="value-card">
            <span class="value-card__num">03</span>
            <h3 class="value-card__title">Long-Term Value Over Transactionalism</h3>
            <p class="value-card__copy">
              We do not seek short-term brokerage. We architect durable joint ventures, permanent distribution networks, and strategic equity partnerships built to endure.
            </p>
          </div>

          <div class="value-card">
            <span class="value-card__num">04</span>
            <h3 class="value-card__title">Institutional Precision &amp; Integrity</h3>
            <p class="value-card__copy">
              From regulatory compliance and intellectual property protection to sovereign fund standards, we execute every milestone with unyielding institutional rigor.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Leadership Section -->
    <section class="section leadership-section" id="leadership" aria-labelledby="leadership-title">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title" id="leadership-title">Meet Our Leadership</h2>
          <p class="section-copy">
            KoreaIN is led with a dedication to building meaningful, well-informed, and enduring connections between Korea and international markets.
          </p>
        </header>

        <div class="leader-feature">
          <div class="leader-portrait">
            <div class="leader-portrait__stage" role="img" aria-label="Portrait of Yaser Khalifa">
              <span class="leader-portrait__orbit" aria-hidden="true"></span>
              <span class="leader-portrait__initials" aria-hidden="true">YK</span>
              <span class="leader-portrait__badge">Executive Leadership</span>
            </div>
          </div>

          <div class="leader-profile">
            <h3 class="leader-name">Yaser Khalifa</h3>
            <p class="leader-title">CEO, KoreaIN</p>
            <div class="leader-badge-pill">
              <span class="leader-badge-pill__dot"></span>
              <span>Member of the Saudi-Korea Business Council</span>
            </div>

            <p class="leader-bio">
              Yaser Khalifa brings extensive cross-border leadership at the intersection of Korean technological enterprise and Saudi Arabian economic diversification. As an active Member of the Saudi-Korea Business Council, he has spearheaded high-level bilateral trade delegations, sovereign investment dialogues, and corporate joint ventures connecting Seoul and Riyadh.
            </p>
            <p class="leader-bio">
              Under his direction, KoreaIN focuses on five high-impact verticals—Consultation, Artificial Intelligence, Automotive &amp; Clean Mobility, Global Investment, and K-Beauty—ensuring that partnerships are grounded in operational feasibility, strategic alignment, and reciprocal growth.
            </p>

            <div class="leader-quote">
              <blockquote>
                "Our mission is to build lasting trust between Korean ingenuity and global ambition. When you align technological leadership with the vision of emerging economic powerhouses, transformative value is created for decades to come."
              </blockquote>
            </div>

            <a href="/contact" class="button button--primary leader-contact-btn">
              <span>Connect with Leadership Office</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="section section-cta">
      <div class="container cta-card">
        <div class="cta-card__body">
          <h2 class="cta-card__title">Explore Partnership with KoreaIN</h2>
          <p class="cta-card__copy">
            Discover how KoreaIN can guide your organization into the Korean market or connect your enterprise with high-growth international opportunities.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="button button--primary">
              <span>Start a Conversation</span>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" />
              </svg>
            </a>
            <a href="/business-areas" class="button button--secondary">
              <span>Explore Our Business Areas</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(2.5rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .breadcrumbs a {
    color: var(--color-muted);
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: var(--color-interactive);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .page-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .page-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-actions svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .page-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-card {
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 8rem;
  }

  .stat-card__number {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .stat-card__label {
    font-size: 0.8125rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  /* Visual Section */
  .visual-section {
    padding-top: clamp(2.5rem, 4.5vw, 4rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  .visual-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .visual-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .visual-figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-caption {
    padding: 1.25rem 1.75rem;
  }

  .visual-caption__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .visual-caption p {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .black-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
  }

  .black-placeholder__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  .black-placeholder__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .black-placeholder__tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .black-placeholder__note {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    max-width: 22rem;
  }

  /* Story Section */
  .story-section {
    background: var(--color-surface);
  }

  .split-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .split-overview__lead .section-title {
    margin-top: 0.5rem;
  }

  .split-overview__body p + p {
    margin-top: 1.5rem;
  }

  /* Values Grid */
  .section-header {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .value-card {
    padding: clamp(2rem, 3.5vw, 2.75rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .value-card__num {
    font-size: 1.25rem;
    font-weight: 750;
    color: var(--color-secondary);
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .value-card__title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.85rem;
  }

  .value-card__copy {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Leadership Section */
  .leadership-section {
    background: var(--color-surface);
  }

  .leader-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 5vw, 4.5rem);
  }

  .leader-portrait {
    width: 100%;
  }

  .leader-portrait__stage {
    aspect-ratio: 4 / 5;
    background: linear-gradient(145deg, #0b1033 0%, #050722 100%);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-card);
  }

  .leader-portrait__stage::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -20%;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .leader-portrait__orbit {
    position: absolute;
    bottom: -15%;
    left: -15%;
    width: 60%;
    height: 60%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.4) 0%, transparent 70%);
  }

  .leader-portrait__initials {
    font-size: clamp(4.5rem, 8vw, 7rem);
    font-weight: 850;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.85);
    position: relative;
    z-index: 2;
  }

  .leader-portrait__badge {
    position: absolute;
    bottom: 1.5rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  .leader-name {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--color-text);
    margin: 0.25rem 0 0.25rem;
  }

  .leader-title {
    font-size: 1.15rem;
    color: var(--color-secondary);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .leader-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1.75rem;
  }

  .leader-badge-pill__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .leader-bio {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .leader-quote {
    margin: 1.75rem 0 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .leader-quote blockquote {
    margin: 0;
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-text);
  }

  .leader-contact-btn {
    margin-top: 0.5rem;
  }

  /* CTA Banner */
  .cta-card {
    background: #050722;
    color: #f7f8fc;
    border-radius: var(--radius-xl);
    padding: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .cta-card::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 71, 160, 0.45) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__body {
    max-width: 44rem;
    position: relative;
    z-index: 2;
  }


  .cta-card__title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .cta-card__copy {
    font-size: 1.1rem;
    color: #c3cadb;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-card__actions .button--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .cta-card__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 63.99rem) {
    .page-hero__grid,
    .visual-grid,
    .split-overview,
    .values-grid,
    .leader-feature {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .page-hero__stats {
      grid-template-columns: 1fr;
    }
  }
</style>