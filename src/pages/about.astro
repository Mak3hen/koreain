---
import BaseLayout from '../layouts/BaseLayout.astro';

const navItems = [
  { id: 'cover', label: 'Overview' },
  { id: 'mission', label: 'Our Mission' },
  { id: 'business-areas', label: 'Business Areas' },
  { id: 'leadership', label: 'Leadership' },
  { id: 'global-corridors', label: 'Global Corridors' },
  { id: 'partnership', label: 'Partnership' }
];

const sections = [
  {
    id: 'mission',
    number: '01',
    category: 'Our Mission',
    title: 'KoreaIN',
    subtitle: 'From Opportunity to Local Impact',
    bgImage: '/home/who-we-are/korea_background-1600.webp',
    desc: 'KoreaIN operates as the dedicated bilateral bridge connecting South Korea with Saudi Arabia and high-growth Arab markets. We identify breakthrough technologies, premium consumer innovations, and industrial know-how in Korea, then export, adapt, and build sustainable local operations from the ground up.',
    actionText: 'Discover Our Mission',
    actionHref: '#leadership'
  },
  {
    id: 'business-areas',
    number: '02',
    category: 'Core Divisions',
    title: 'Business Areas',
    subtitle: 'High-Impact Industry Verticals',
    bgImage: '/home/who-we-are/innovation-1600.webp',
    desc: 'Five specialized, synergistic divisions translating Korean technological and manufacturing superiority into enduring market leadership across the Middle East: Business Consulting, Artificial Intelligence, Automotive & Clean Mobility, Strategic Investment, and K-Beauty.',
    actionText: 'Explore Business Areas',
    actionHref: '/business-areas'
  },
  {
    id: 'leadership',
    number: '03',
    category: 'Executive Leadership',
    title: 'Leadership & Heritage',
    subtitle: 'A 20-Year Korean Foundation',
    bgImage: '/home/who-we-are/lotte_tower-1600.webp',
    desc: 'Led by Founder & CEO Yasser Al Amoudi, whose 20-year journey living, studying, and working in South Korea built an intimate fluency in Korean corporate culture. Decades of personal relationships with government officials, enterprise owners, and chaebol leadership guarantee high-trust access and seamless execution.',
    actionText: 'Connect with Leadership',
    actionHref: '/contact'
  },
  {
    id: 'global-corridors',
    number: '04',
    category: 'Global Presence',
    title: 'Global Corridors',
    subtitle: 'Connecting Seoul, Riyadh & Global Hubs',
    bgImage: '/home/who-we-are/saudi_arabia-1600.webp',
    desc: 'With primary operations anchored along the Seoul–Riyadh corridor and active engagements across the GCC and North Africa, KoreaIN bridges the world’s most dynamic manufacturing and technology hub with the transformative economic visions of the Arab world.',
    actionText: 'Explore Global Markets',
    actionHref: '/global-markets'
  },
  {
    id: 'partnership',
    number: '05',
    category: 'Next Steps',
    title: 'Strategic Partnership',
    subtitle: 'Bring the Next Opportunity Closer',
    bgImage: '/home/business-areas/investment.webp',
    desc: 'Whether you are a Korean corporation expanding into Arab markets or an international enterprise seeking direct access to South Korea’s leading innovators and manufacturers, KoreaIN provides the trusted platform to build joint ventures and enduring market value.',
    actionText: 'Start a Conversation',
    actionHref: '/contact'
  }
];
---

<BaseLayout
  title="About Us | KoreaIN — Strategic Bridge Between Korea and the Arab World"
  description="Discover KoreaIN's mission, leadership, core divisions, and global reach. Recreated with Amorepacific-style full-bleed animations, mouse parallax, and choreographed section slide-ups."
>
  <main id="main-content" class="about-us-portal">
    <!-- Floating Side Dot Navigation (Amorepacific .local-nav) -->
    <nav class="local-nav" aria-label="About Us navigation">
      <ul class="local-nav-list">
        {navItems.map((item, index) => (
          <li class={index === 0 ? 'is-current' : ''} data-target={item.id}>
            <a href={`#${item.id}`} class="local-nav-link" aria-label={item.label}>
              <span class="nav-tooltip">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Cover Section (Full Viewport Hero with Parallax & Fade-out) -->
    <header id="cover" class="cover" aria-labelledby="cover-title">
      <div class="cover-spacer">
        <div
          class="cover-bg"
          id="coverBg"
          style="background-image: url('/general_data/about_hero.png');"
        ></div>
        <div class="cover-overlay"></div>
      </div>

      <div class="container cover-content" id="coverContent">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">About Us</li>
          </ol>
        </nav>

        <h1 id="cover-title" class="cover-h">About Us</h1>
        <p class="cover-desc">
          KoreaIN shapes the bilateral bridge connecting South Korea with Saudi Arabia and the Arab world. Guided by trusted relationships and execution excellence, we transform cross-border innovation into sustainable value, joint ventures, and enduring market impact.
        </p>
      </div>

      <!-- Animated Mouse Scroll Indicator -->
      <a href="#mission" class="cover-mouse" id="coverMouse" aria-label="Scroll to first section">
        <span class="mouse-icon"></span>
        <span class="mouse-text">Scroll</span>
      </a>
    </header>

    <!-- Sub-sections Showcase (Amorepacific Full-Screen Interactive Sections) -->
    <div class="page-contents">
      {sections.map((section) => (
        <section
          id={section.id}
          class="sub-section sub-section-full sub-section-common"
          data-section-id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <!-- Full-Bleed Background Visual Header -->
          <div class="sub-section-header" style={`background-image: url('${section.bgImage}');`}>
            <div class="sub-section-header__overlay"></div>

            <!-- Signature Amorepacific Animated Horizontal Line -->
            <div class="sub-section-deco" aria-hidden="true"></div>

            <!-- Vertically Floating Title -->
            <div class="sub-section-title-wrap">
              <span class="sub-section-meta">
                <span class="sub-section-number">{section.number}</span>
                <span class="sub-section-category">{section.category}</span>
              </span>
              {section.id === 'mission' ? (
                <h2 id={`${section.id}-title` as any} class="sub-section-h sub-section-h--logo">
                  <img
                    src="/images/logoK-IN-light.svg"
                    alt="KoreaIN"
                    class="sub-section-logo-img"
                    width="280"
                    height="140"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="sr-only">KoreaIN</span>
                </h2>
              ) : (
                <h2 id={`${section.id}-title` as any} class="sub-section-h">
                  {section.title}
                </h2>
              )}
            </div>
          </div>

          <!-- Slide-Up Content Drawer -->
          <div class="sub-section-content-container">
            <div class="container">
              <div class="sub-section-content">
                <div class="content-left">
                  <h3 class="content-subtitle">{section.subtitle}</h3>
                  <p class="sub-section-desc">{section.desc}</p>
                </div>

                <div class="content-right">
                  <a href={section.actionHref} class="sub-section-more">
                    <span>{section.actionText}</span>
                    <svg class="more-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M4 10h11M11 5l5 5-5 5" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<script is:inline>
  // ============================================================================
  // Amorepacific Animation & Scroll Engine for KoreaIN
  // ============================================================================
  document.addEventListener('DOMContentLoaded', () => {
    const cover = document.getElementById('cover');
    const coverBg = document.getElementById('coverBg');
    const coverContent = document.getElementById('coverContent');
    const coverMouse = document.getElementById('coverMouse');
    const sections = Array.from(document.querySelectorAll('.sub-section'));
    const navItems = Array.from(document.querySelectorAll('.local-nav-list li'));

    // 1. Hero Cover Entrance & Mousemove Parallax
    if (cover && coverBg) {
      coverBg.classList.add('is-loaded');

      if (window.matchMedia('(min-width: 1024px)').matches) {
        cover.addEventListener('mousemove', (e) => {
          const rect = cover.getBoundingClientRect();
          const x = (e.clientX - rect.width / 2) / (rect.width / 2);
          const y = (e.clientY - rect.height / 2) / (rect.height / 2);
          coverBg.style.transform = `scale(1.05) translate(${x * -20}px, ${y * -14}px)`;
        });

        cover.addEventListener('mouseleave', () => {
          coverBg.style.transform = 'scale(1) translate(0, 0)';
        });
      }
    }

    // 2. Cover Content Scroll Fade-Out
    const handleScrollFade = () => {
      const scrollY = window.scrollY;
      const fadeThreshold = window.innerHeight * 0.45;

      if (coverContent) {
        const opacity = Math.max(0, 1 - scrollY / fadeThreshold);
        const translateY = scrollY * 0.32;
        coverContent.style.opacity = opacity.toFixed(2);
        coverContent.style.transform = `translateY(${translateY.toFixed(1)}px)`;
      }

      if (coverMouse) {
        coverMouse.style.opacity = Math.max(0, 1 - scrollY / (fadeThreshold * 0.5)).toFixed(2);
      }
    };

    window.addEventListener('scroll', handleScrollFade, { passive: true });

    // 3. Section Reveal & Choreographed Slide-Up Animation (Amorepacific Effect)
    const sectionObserverOptions = {
      root: null,
      rootMargin: '-15% 0px -25% 0px',
      threshold: [0.15, 0.45]
    };

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const targetId = entry.target.id;
        if (entry.isIntersecting) {
          entry.target.classList.add('is-active');

          navItems.forEach((li) => {
            if (li.getAttribute('data-target') === targetId) {
              li.classList.add('is-current');
            } else {
              li.classList.remove('is-current');
            }
          });
        }
      });
    }, sectionObserverOptions);

    sections.forEach((sec) => sectionObserver.observe(sec));

    // Observe cover for navigation dot
    if (cover) {
      const coverObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              navItems.forEach((li) => {
                if (li.getAttribute('data-target') === 'cover') {
                  li.classList.add('is-current');
                } else {
                  li.classList.remove('is-current');
                }
              });
            }
          });
        },
        { threshold: 0.5 }
      );
      coverObserver.observe(cover);
    }

    // 4. Smooth Anchor Link Scrolling
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // 5. Desktop Keyboard Up/Down Section Navigation
    window.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'PageDown'].includes(e.key)) {
        const currentScroll = window.scrollY;
        const nextSec = sections.find((s) => s.offsetTop > currentScroll + 80);
        if (nextSec) {
          e.preventDefault();
          nextSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } else if (['ArrowUp', 'PageUp'].includes(e.key)) {
        const currentScroll = window.scrollY;
        const prevSecs = [...sections].reverse();
        const prevSec = prevSecs.find((s) => s.offsetTop < currentScroll - 80);
        if (prevSec) {
          e.preventDefault();
          prevSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else if (currentScroll > 100 && cover) {
          e.preventDefault();
          cover.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>

<style>
  /* ==========================================================================
     Amorepacific Exact Animation & Scroll Mechanics (Clean & Spacious)
     ========================================================================== */

  .about-us-portal {
    position: relative;
    background: var(--color-bg);
  }

  /* --------------------------------------------------------------------------
     1. Floating Side Dot Navigation (.local-nav)
     -------------------------------------------------------------------------- */
  .local-nav {
    display: none;
    position: fixed;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 60;
    background: rgba(11, 16, 51, 0.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    padding: 1rem 0.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: opacity 300ms ease;
  }

  @media (min-width: 1024px) {
    .local-nav {
      display: block;
    }
  }

  .local-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .local-nav-list li {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }

  .local-nav-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  /* Dot default */
  .local-nav-link::before {
    content: '';
    width: 7px;
    height: 7px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    transition: all 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .local-nav-link:hover::before {
    background: #ffffff;
    transform: scale(1.35);
  }

  /* Dot Active State (Amorepacific ring) */
  .local-nav-list li.is-current .local-nav-link::before {
    width: 11px;
    height: 11px;
    background: transparent;
    border: 2px solid #ffffff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
    transform: scale(1);
  }

  /* Tooltip on hover */
  .nav-tooltip {
    position: absolute;
    right: 2.25rem;
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #0b1033;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease, transform 220ms ease;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .local-nav-link:hover .nav-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* --------------------------------------------------------------------------
     2. Cover Hero Section (.cover) - Clean & Spacious
     -------------------------------------------------------------------------- */
  .cover {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #ffffff;
    overflow: hidden;
  }

  .cover-spacer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .cover-bg {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center 38%;
    background-repeat: no-repeat;
    transform: scale(1.06) translateX(25px);
    opacity: 0.85;
    transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.2s ease;
    will-change: transform;
  }

  .cover-bg.is-loaded {
    transform: scale(1) translateX(0);
    opacity: 1;
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 7, 34, 0.75) 0%,
      rgba(5, 7, 34, 0.58) 50%,
      rgba(5, 7, 34, 0.88) 100%
    );
  }

  .cover-content {
    position: relative;
    z-index: 2;
    max-width: 62rem;
    padding-top: var(--header-height);
    transition: opacity 150ms linear, transform 150ms linear;
    will-change: opacity, transform;
  }

  .breadcrumbs {
    margin-bottom: 2.25rem;
    animation: fadeInText 0.8s ease backwards 0.2s;
  }

  .breadcrumbs ol {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-right: 0.75rem;
    opacity: 0.4;
  }

  .breadcrumbs a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .breadcrumbs a:hover {
    color: #ffffff;
  }

  .breadcrumbs [aria-current="page"] {
    color: #ffffff;
    font-weight: 500;
  }

  .cover-h {
    margin: 0 0 1.75rem;
    font-size: clamp(3.25rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #ffffff;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.45);
    text-wrap: balance;
    animation: fadeInText 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards 0.4s;
  }

  .cover-desc {
    margin: 0;
    font-size: clamp(1.15rem, 1.65vw, 1.45rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.88);
    max-width: 50rem;
    font-weight: 300;
    text-wrap: pretty;
    animation: fadeInText 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards 0.6s;
  }

  @keyframes fadeInText {
    0% {
      opacity: 0;
      transform: translateY(22px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mouse Scroll Indicator (Amorepacific #ain-mouse) */
  .cover-mouse {
    position: absolute;
    bottom: 2.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    transition: color 200ms ease, opacity 200ms ease;
    animation: fadeInText 1s ease backwards 1s;
  }

  .cover-mouse:hover {
    color: #ffffff;
  }

  .mouse-icon {
    width: 22px;
    height: 36px;
    border: 1.8px solid rgba(255, 255, 255, 0.65);
    border-radius: 12px;
    position: relative;
  }

  .mouse-icon::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    width: 3.5px;
    height: 7px;
    background: #ffffff;
    border-radius: 2px;
    transform: translateX(-50%);
    animation: mouseWheel 2s infinite cubic-bezier(0.65, 0, 0.35, 1);
  }

  .mouse-text {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }

  @keyframes mouseWheel {
    0% {
      transform: translate(-50%, 0);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, 14px);
      opacity: 0;
    }
  }

  /* --------------------------------------------------------------------------
     3. Section Choreography & Animations (.sub-section) - Clean & Spacious
     -------------------------------------------------------------------------- */
  .page-contents {
    position: relative;
  }

  .sub-section {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Desktop Full-Screen Section Behavior (Amorepacific style) */
  @media (min-width: 1024px) {
    .sub-section.sub-section-full {
      height: calc(100vh - var(--header-height));
      min-height: 640px;
    }

    .sub-section-header {
      position: absolute;
      inset: 0;
      height: 100%;
      background-size: cover;
      background-position: center;
      background-attachment: fixed; /* Parallax fixed background */
    }

    /* Initial state: title & deco centered at top: 50% */
    .sub-section-title-wrap {
      position: absolute;
      left: clamp(55px, 10vw, 130px);
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      opacity: 0;
      transition: top 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
      will-change: top, opacity;
    }

    /* Amorepacific Signature Decorative Line */
    .sub-section-deco {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 0;
      height: 1px;
      background: rgba(255, 255, 255, 0.45);
      z-index: 3;
      opacity: 0;
      transition: width 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
      will-change: width, opacity;
    }

    .sub-section-deco::after {
      content: '';
      position: absolute;
      right: -4px;
      top: -3px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
    }

    /* Slide-Up Drawer: Initially hidden below viewport */
    .sub-section-content-container {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 40%;
      background: var(--color-surface);
      transform: translateY(100%);
      opacity: 0;
      z-index: 4;
      display: flex;
      align-items: center;
      box-shadow: 0 -15px 40px rgba(0, 0, 0, 0.15);
      transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
      will-change: transform, opacity;
    }

    /* Animated entrance when section is active */
    .sub-section.is-active .sub-section-title-wrap {
      top: 28%; /* Moves upward as in Amorepacific */
      opacity: 1;
    }

    .sub-section.is-active .sub-section-deco {
      top: 28%;
      width: clamp(40px, 8vw, 110px);
      opacity: 0.6;
    }

    .sub-section.is-active .sub-section-content-container {
      transform: translateY(0); /* Slides up into view! */
      opacity: 1;
    }

    .sub-section .content-left,
    .sub-section .content-right {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s ease 0.35s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
    }

    .sub-section.is-active .content-left,
    .sub-section.is-active .content-right {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Header Background & Overlay */
  .sub-section-header {
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .sub-section-header__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(5, 7, 34, 0.82) 0%,
      rgba(5, 7, 34, 0.52) 55%,
      rgba(5, 7, 34, 0.32) 100%
    );
  }

  .sub-section-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .sub-section-number {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #a6b8ff;
    letter-spacing: 0.1em;
  }

  .sub-section-category {
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 500;
  }

  .sub-section-h {
    margin: 0;
    font-size: clamp(2.35rem, 5vw, 4.25rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: #ffffff;
    text-shadow: 0 4px 25px rgba(0, 0, 0, 0.5);
    text-wrap: balance;
  }

  .sub-section-h--logo {
    display: flex;
