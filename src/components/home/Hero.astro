<div class="hero" data-hero>
  <video
    id="hero-background-video"
    class="hero__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/homepage.mp4" type="video/mp4" />
  </video>
  <div class="hero__top-shade" aria-hidden="true"></div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__signature">
    <p class="hero__eyebrow">
      <span>KOREA</span>
      <span class="hero__eyebrow-line" aria-hidden="true"></span>
      <span>GLOBAL</span>
    </p>
    <h1 class="hero__tagline">Connecting Korea to Global Partners</h1>
  </div>
  <button
    class="hero__motion"
    type="button"
    data-video-toggle
    data-state="paused"
    aria-controls="hero-background-video"
    aria-label="Resume background video"
    hidden
  >
    <svg class="hero__pause-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" /></svg>
    <svg class="hero__play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 8 5-8 5Z" /></svg>
    <span data-video-label>Resume</span>
  </button>
  <span class="sr-only" data-video-status aria-live="polite"></span>
</div>

<script>
  const setupHeroVideo = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const video = hero?.querySelector<HTMLVideoElement>('video');
    const button = hero?.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const label = button?.querySelector<HTMLElement>('[data-video-label]');
    const status = hero?.querySelector<HTMLElement>('[data-video-status]');
    if (!hero || !video || !button || !label || !status || hero.dataset.ready === 'true') return;
    hero.dataset.ready = 'true';

    const sync = () => {
      const paused = video.paused;
      button.dataset.state = paused ? 'paused' : 'playing';
      button.setAttribute('aria-label', paused ? 'Resume background video' : 'Pause background video');
      label.textContent = paused ? 'Resume' : 'Pause';
    };
    const play = async (explicit = false) => {
      status.textContent = '';
      try {
        await video.play();
      } catch {
        if (explicit) status.textContent = 'The background video could not start. Please try again.';
      }
      sync();
    };

    video.muted = true;
    video.autoplay = true;
    void play();

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    button.addEventListener('click', () => {
      if (video.paused) {
        void play(true);
      } else {
        video.autoplay = false;
        video.pause();
      }
    });
    video.addEventListener('error', () => {
      button.disabled = true;
      status.textContent = 'The background video is unavailable.';
      sync();
    });
    sync();
    button.hidden = false;
  };
  setupHeroVideo();
  document.addEventListener('astro:page-load', setupHeroVideo);
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100svh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #050722;
  }
  .hero__video {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The tower is at ~46% of the source width; retain its tip on wide screens. */
    object-position: 50% 15%;
  }
  .hero__top-shade {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    height: clamp(6.5rem, 16svh, 11rem);
    background: linear-gradient(180deg, rgba(5, 7, 34, 0.65) 0%, rgba(5, 7, 34, 0.25) 50%, transparent 100%);
    pointer-events: none;
  }
  .hero__shade {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(to bottom, rgba(5, 7, 34, 0), rgba(5, 7, 34, 0.2) 40%, rgba(5, 7, 34, 0.66));
    pointer-events: none;
  }
  .hero__signature {
    position: absolute;
    z-index: 2;
    left: max(var(--gutter), calc((100% - var(--container)) / 2));
    bottom: max(clamp(2rem, 6svh, 4.5rem), env(safe-area-inset-bottom, 0px));
    width: min(46rem, 75%);
    animation: hero-signature-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    margin: 0 0 1.125rem;
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1;
  }
  .hero__eyebrow-line { width: 2.5rem; height: 2px; flex: 0 0 auto; background: #cd2e3a; }
  .hero__tagline {
    margin: 0;
    color: #fff;
    font-size: clamp(3rem, 4.5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
    text-shadow: 0 2px 16px rgba(5, 7, 34, 0.32);
  }
  .hero__motion {
    position: absolute;
    z-index: 3;
    right: max(var(--gutter), calc((100% - var(--container)) / 2));
    bottom: max(clamp(2rem, 6svh, 4.5rem), env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 0.5rem;
    color: #fff;
    background: rgba(5, 7, 34, 0.84);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .hero__motion[hidden] { display: none; }
  .hero__motion:hover { background: #0b1033; }
  .hero__motion:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .hero__motion svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .hero__motion[data-state='playing'] .hero__play-icon,
  .hero__motion[data-state='paused'] .hero__pause-icon { display: none; }
  @keyframes hero-signature-enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 63.99rem) {
    .hero__video { object-position: 47% 20%; }
    .hero__signature { width: min(40rem, 88%); }
    .hero__tagline { font-size: clamp(2.5rem, 5.5vw, 3.25rem); }
    .hero__motion { top: 1.25rem; bottom: auto; }
  }
  @media (max-width: 39.99rem) {
    /* Intentional portrait crop: the old 62% placed Lotte Tower off the left edge. */
    .hero__video { object-position: 45% 20%; }
    .hero__signature { left: var(--gutter); right: var(--gutter); width: auto; bottom: max(2.25rem, env(safe-area-inset-bottom, 0px)); }
    .hero__tagline { font-size: clamp(2rem, 8.4vw, 2.5rem); }
    .hero__eyebrow { font-size: 0.75rem; gap: 0.75rem; }
    .hero__eyebrow-line { width: 2rem; }
    .hero__motion { top: 1rem; }
  }
  @media (max-height: 34rem) {
    .hero__signature { bottom: 1.25rem; width: min(38rem, 75%); }
    .hero__tagline { font-size: clamp(1.625rem, 6svh, 2.25rem); }
    .hero__eyebrow { font-size: 0.75rem; margin-bottom: 0.625rem; }
    .hero__motion { top: 1rem; bottom: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__signature { animation: none; }
    .hero__motion { transition: none; }
  }
</style>
