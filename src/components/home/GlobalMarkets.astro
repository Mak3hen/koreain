---
const markets = [
  { name: 'Korea', context: 'Home base' },
  { name: 'Saudi Arabia', context: 'Key connection' },
  { name: 'Middle East', context: 'Regional focus' },
  { name: 'International Markets', context: 'Global outlook' }
] as const;
---

<section class="section global-markets" id="markets" aria-labelledby="markets-title">
  <div class="container">
    <div class="global-markets__heading">
      <div>
        <p class="eyebrow global-markets__eyebrow">Our reach</p>
        <h2 class="section-title global-markets__title" id="markets-title">
          From Korea to<br />Global Markets
        </h2>
      </div>

      <p class="section-copy global-markets__copy">
        KoreaIN creates a clear path between Korean expertise and international
        business opportunities, with a focused connection to Saudi Arabia and
        the Middle East.
      </p>
    </div>

    <ol class="market-path" aria-label="KoreaIN's international market focus">
      {
        markets.map((market, index) => (
          <li class="market-path__item">
            <div class="market-path__marker" aria-hidden="true">
              <span />
            </div>
            <p class="market-path__index">{String(index + 1).padStart(2, '0')}</p>
            <h3>{market.name}</h3>
            <p class="market-path__context">{market.context}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .global-markets {
    position: relative;
    overflow: hidden;
    color: #f7f8fc;
    background:
      radial-gradient(circle at 92% 15%, rgba(0, 71, 160, 0.34), transparent 34rem),
      #050722;
  }

  .global-markets::after {
    position: absolute;
    right: -10rem;
    bottom: -15rem;
    width: 31rem;
    height: 31rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .global-markets__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.68fr);
    gap: clamp(4rem, 9vw, 9rem);
    align-items: end;
  }

  .global-markets__eyebrow {
    color: #91b8f0;
  }

  .global-markets__title {
    max-width: 12ch;
    margin-top: 1rem;
    color: #f7f8fc;
  }

  .global-markets__copy {
    max-width: 38rem;
    color: #b6bed1;
    font-size: clamp(1.08rem, 1.5vw, 1.24rem);
  }

  .market-path {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.8vw, 1.5rem);
    margin: clamp(5rem, 8vw, 8rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .market-path::before {
    position: absolute;
    top: 1.15rem;
    right: calc(12.5% - 0.25rem);
    left: calc(12.5% - 0.25rem);
    height: 1px;
    background: linear-gradient(90deg, #0047a0, #6176d7 68%, #cd2e3a);
    content: '';
  }

  .market-path__item {
    position: relative;
    min-height: 16rem;
    padding: 4.75rem clamp(1.5rem, 2.7vw, 2.5rem) 2.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    background: #0b1033;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .market-path__item:hover {
    border-color: rgba(145, 184, 240, 0.35);
    background: #0e1540;
    transform: translateY(-0.15rem);
  }

  .market-path__marker {
    position: absolute;
    top: 0.78rem;
    left: 50%;
    z-index: 1;
    display: grid;
    width: 0.75rem;
    height: 0.75rem;
    place-items: center;
    border: 3px solid #050722;
    border-radius: 50%;
    background: #6f8ee1;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.42);
    transform: translateX(-50%);
  }

  .market-path__item:first-child .market-path__marker {
    background: #0047a0;
  }

  .market-path__item:last-child .market-path__marker {
    background: #cd2e3a;
  }

  .market-path__index,
  .market-path__context {
    margin: 0;
    color: #929bb3;
    font-size: 0.73rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .market-path h3 {
    margin: 1.4rem 0 0.7rem;
    color: #f7f8fc;
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .market-path__context {
    color: #aab3c9;
    letter-spacing: 0.06em;
  }

  @media (max-width: 60rem) {
    .global-markets__heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .global-markets__title br {
      display: none;
    }

    .market-path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .market-path::before {
      display: none;
    }

    .market-path__item {
      min-height: 13rem;
      padding: 2.75rem 2rem 2rem;
    }

    .market-path__marker {
      top: 1.05rem;
      right: 1.1rem;
      left: auto;
      transform: none;
    }
  }

  @media (max-width: 35rem) {
    .market-path {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .market-path__item {
      min-height: 0;
      padding: 2rem;
    }

    .market-path__marker {
      top: 1.5rem;
      right: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .market-path__item {
      transition: none;
    }
  }
</style>
