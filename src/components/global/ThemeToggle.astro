<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Switch to dark theme"
>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none">
      <path
        d="M20.2 15.7A8.5 8.5 0 0 1 8.3 3.8 8.6 8.6 0 1 0 20.2 15.7Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.8" />
      <path
        d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.28 5.28 6.7 6.7M17.3 17.3l1.42 1.42M18.72 5.28 17.3 6.7M6.7 17.3l-1.42 1.42"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
    </svg>
  </span>
  <span class="theme-toggle__label">Switch to dark theme</span>
</button>

<script>
  type Theme = 'light' | 'dark';

  const storageKey = 'koreain-theme';

  const isTheme = (value: string | null | undefined): value is Theme =>
    value === 'light' || value === 'dark';

  const preferredTheme = (): Theme =>
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

  const activeTheme = (): Theme => {
    const currentTheme = document.documentElement.dataset.theme;
    return isTheme(currentTheme) ? currentTheme : preferredTheme();
  };

  const syncThemeControls = (theme: Theme) => {
    const darkModeIsActive = theme === 'dark';
    const actionLabel = darkModeIsActive
      ? 'Switch to light theme'
      : 'Switch to dark theme';

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(darkModeIsActive));
      toggle.setAttribute('aria-label', actionLabel);
      toggle.title = actionLabel;

      const label = toggle.querySelector<HTMLElement>('.theme-toggle__label');
      if (label) label.textContent = actionLabel;
    });
  };

  const applyTheme = (theme: Theme, persist = false) => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    document.querySelector<HTMLMetaElement>('[data-theme-color]')?.setAttribute(
      'content',
      theme === 'dark' ? '#050722' : '#F5F7FB',
    );
    syncThemeControls(theme);

    if (persist) {
      try {
        window.localStorage.setItem(storageKey, theme);
      } catch {
        // The selected theme still applies when storage is unavailable.
      }
    }
  };

  const setupThemeToggles = () => {
    applyTheme(activeTheme());

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((toggle) => {
      if (toggle.dataset.themeToggleReady === 'true') return;

      toggle.dataset.themeToggleReady = 'true';
      toggle.addEventListener('click', () => {
        applyTheme(activeTheme() === 'dark' ? 'light' : 'dark', true);
      });
    });
  };

  setupThemeToggles();
  document.addEventListener('astro:page-load', setupThemeToggles);

  if (document.documentElement.dataset.themeStorageListener !== 'true') {
    document.documentElement.dataset.themeStorageListener = 'true';
    window.addEventListener('storage', (event) => {
      if (event.key !== storageKey) return;
      applyTheme(isTheme(event.newValue) ? event.newValue : preferredTheme());
    });
  }
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-interactive);
    color: var(--color-interactive);
    transform: translateY(-1px);
  }

  .theme-toggle:focus-visible {
    outline: 3px solid var(--color-interactive);
    outline-offset: 3px;
  }

  .theme-toggle__icon {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  .theme-toggle__icon svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  .theme-toggle__sun {
    opacity: 0;
    transform: rotate(-35deg) scale(0.75);
  }

  .theme-toggle__moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(html[data-theme='dark']) .theme-toggle__sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(html[data-theme='dark']) .theme-toggle__moon {
    opacity: 0;
    transform: rotate(35deg) scale(0.75);
  }

  .theme-toggle__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__icon svg {
      transition: none;
    }
  }
</style>
